{
  "captured_at_utc": "2026-09-11T05:16:48.670687+00:00",
  "head": "1a2d0d7",
  "scope": "read-only R&D aggregate audit; no user content",
  "queries": {
    "labels": "MATCH (n) UNWIND labels(n) AS label RETURN label,count(*) AS count ORDER BY label",
    "relationship_types": "MATCH ()-[r]->() RETURN type(r) AS type,count(*) AS count ORDER BY type",
    "experience_types": "MATCH (e:Experience) RETURN e.task_type AS type,count(*) AS count,count(e.embedding) AS embedded,max(toString(e.created_at)) AS latest ORDER BY count DESC",
    "experience_fields": "MATCH (e:Experience) RETURN count(e) AS total,count(e.speaker_id) AS speaker_id,count(e.recalled_ids) AS recalled_ids,count(e.recall_conf) AS recall_conf,count(e.surprise_z) AS surprise_z,count(e.head_pose) AS head_pose,count(e.depth_bins) AS depth_bins,count(e.channel) AS channel,count(e.valid_from) AS valid_from,count(e.valid_to) AS valid_to",
    "vision_fields": "MATCH (e:Experience {task_type:'vision'}) RETURN count(e) AS total,count(e.head_pose) AS head_pose,count(e.depth_bins) AS depth_bins,count(e.prediction_snapshot) AS prediction_snapshot,max(toString(e.created_at)) AS latest",
    "concept_embeddings": "MATCH (c:Concept) RETURN count(c) AS total,count(c.embedding) AS embedded",
    "embedding_dimensions": "MATCH (e:Experience) WHERE e.embedding IS NOT NULL RETURN size(e.embedding) AS dimensions,count(*) AS count",
    "experience_speaker_links": "MATCH (e:Experience) WHERE EXISTS { MATCH (e)-[:INTERACTED_WITH]->(:UserModel) } RETURN count(e) AS linked",
    "prediction_fields": "MATCH (p:Prediction) RETURN count(p) AS total,count(p.was_correct) AS scored,count(CASE WHEN p.was_correct = true THEN 1 END) AS marked_correct,count(p.policy_action_id) AS policy_action_id,count(p.actual_outcome) AS actual_outcome",
    "question_fields": "MATCH (q:PendingQuestion) RETURN count(q) AS total,count(q.policy_action_id) AS policy_action_id,count(q.prediction_snapshot) AS prediction_snapshot,count(q.answer) AS answer",
    "relevant_property_keys": "MATCH (n) WHERE any(l IN labels(n) WHERE l IN ['Prediction','Procedure','PendingQuestion','BabyState']) UNWIND keys(n) AS property RETURN labels(n) AS labels,property,count(*) AS count ORDER BY labels,property",
    "vector_indexes": "SHOW INDEXES YIELD name,type,labelsOrTypes,properties,options,state WHERE type='VECTOR' RETURN name,labelsOrTypes,properties,options,state",
    "question_contract_fields": "MATCH (q:PendingQuestion) RETURN count(q) AS total,count(q.question_outcome_policy_action_key) AS action_key,count(q.predicted_concept_ids) AS predicted_concept_ids,count(q.prediction_captured_at) AS prediction_captured_at,count(q.external_outcome_concept_ids) AS external_outcome_concept_ids,count(q.question_outcome_split) AS split",
    "speaker_link_distribution": "MATCH (u:UserModel) OPTIONAL MATCH (e:Experience)-[:INTERACTED_WITH]->(u) WITH u,count(DISTINCT e) AS n RETURN n AS linked_experiences ORDER BY n DESC",
    "experience_index_probe": "MATCH (e:Experience) WHERE e.embedding IS NOT NULL WITH e.embedding AS emb LIMIT 1 CALL db.index.vector.queryNodes('experience_embeddings',1,emb) YIELD node,score RETURN count(node) AS hits",
    "actual_index_probe": "MATCH (e:Experience) WHERE e.embedding IS NOT NULL WITH e.embedding AS emb LIMIT 1 CALL db.index.vector.queryNodes('index_2bacf740',1,emb) YIELD node,score RETURN count(node) AS hits",
    "next_frame_fields": "MATCH ()-[r:NEXT_FRAME]->() RETURN count(r) AS total,count(r.pose_delta) AS pose_delta",
    "question_relations": "MATCH (:PendingQuestion)-[r]->() RETURN type(r) AS type,count(r) AS count"
  },
