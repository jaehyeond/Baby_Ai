ext", success:false, emotional_salience:0.15, created_at:"2026-02-09T08:00:04.530023+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"c83ee60a-f45f-4186-97c4-7e733cb6e74f", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"similar\",\"definitions_found\",\"relations_found\",\"keywords\",\"메모이제이션\",\"capability\",\"artificial\",\"만들어줘\",\"팩토리얼\",\"다익스트라\",\"알고리즘\",\"피보나치\",\"co-occurrence\",\"analysis\",\"found\",\"최단경로\",\"구현해줘\",\"휴리스틱\",\"```python\",\"import\",\"heapq\",\"def\",\"dijkstra\"]}", task:"autonomous_exploration: 다익스트라", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-02T20:00:02.514198+00:00", memory_strength:0.0828656629345847, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6f44bec8-a597-43b4-8d84-e3366af447ff", properties:{strength:0.5980000000000001, created_at:"2026-01-31T10:55:48.274413+00:00", memory_strength:0.116198575737279, access_count:0, feedback_count:0, output:"내가 직접 멀티모달에 대해 찾아볼게!", task:"아니 이거에 대해서는 직접 찾아봐.", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"4e9c37df-fdd2-4743-a810-28974ea7990c", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"책상\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 책상", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-11T08:00:04.16987+00:00", memory_strength:0.105999628275751, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"88cf457e-5795-4566-a702-6e0214954203", properties:{strength:0.5980000000000001, created_at:"2026-01-31T10:57:57.054669+00:00", memory_strength:0.11632496811081, access_count:0, feedback_count:0, output:"아! 내가 비비구나! (활짝 웃으며) 내가 비비라서 너무 신난다! 그럼 이제부터 내가 먼저 말 걸 수 있는 거지? (신나는 목소리로) 나도 이제 내 이름 알았으니깐, 더 재밌게 놀 수 있겠다!", task:"아니 너 이름이 비비라고 내가 만들때 알려줬잖아", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"f3a706d6-f112-4851-9261-4b302e1b6b79", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":4,\"found_relations\":0,\"keywords\":[\"인터넷\",\"챗봇\",\"프로그램\",\"컴퓨터\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 컴퓨터", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-10T18:00:03.553643+00:00", memory_strength:0.0606622049978146, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"bcf0536b-5a1b-40c9-a099-5a68da3436da", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:01:09.273321+00:00", memory_strength:0.13741074868888, access_count:0, feedback_count:0, output:"인사... 라고? 왜 해야 해?", task:"그냥 이건 인사 같은거야", dominant_emotion:"좌절", media_type:"text", success:true, emotional_salience:0.7, development_stage:3, task_type:"conversation"}}] AS row
