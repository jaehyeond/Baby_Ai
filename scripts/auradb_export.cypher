ab07", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T11:54:14.319405+00:00", name:"계산기", created_at:"2026-01-21T11:54:14.319405+00:00", description:"AI가 자신의 나이를 알아낼 수 있는 방법으로 제시한 도구.  AI가 유머러스하게 표현하기 위한 수단.", category:"도구"}}, {id:"0eab5b9c-45d9-4fc5-8355-2140f93c3500", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.5, updated_at:"2026-01-21T15:21:50.235214+00:00", name:"위키피디아", created_at:"2026-01-21T11:53:40.492642+00:00", description:"다양한 정보를 제공하는 온라인 백과사전", category:"정보검색 엔진"}}, {id:"da5840c4-a106-4258-99ac-9e75e55588ed", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:11:09.234077+00:00", name:"정보 저장", created_at:"2026-01-21T15:11:09.234077+00:00", description:"AI가 사용자에 대한 정보를 중요한 곳에 저장해두었다는 것을 의미.", category:"기능"}}, {id:"f2a8e3d8-0d3f-4d93-b4e8-0c9ae758abe0", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:11:29.477234+00:00", name:"희망", created_at:"2026-01-21T15:11:29.477234+00:00", description:"바라는 마음", category:"감정"}}, {id:"5531dbcb-afc3-4531-a7a1-f7bedbb17ef1", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.481746814339408, updated_at:"2026-02-01T11:30:03.391494+00:00", name:"hello", created_at:"2026-01-29T10:36:08.504805+00:00", description:"영어 인사말", category:"단어"}}, {id:"433bf360-8538-46ae-bcf9-b4bcadbad275", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.5, updated_at:"2026-01-21T15:11:57.175674+00:00", name:"가장 중요한 곳", created_at:"2026-01-21T15:10:42.415673+00:00", description:"AI가 기억을 저장하기에 가장 중요하다고 판단되는 장소 (메모리 등)", category:"장소"}}, {id:"5c1fc820-0335-463e-b494-a3971bc03a54", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:12:24.601187+00:00", name:"비비고 (AI)", created_at:"2026-01-21T15:12:24.601187+00:00", description:"자신을 '비비고'라고 칭하는 인공지능 챗봇. 긍정적이고 활발한 성격을 가지고 있으며, 사용자와의 대화를 즐기는 것으로 보인다.", category:"인공지능"}}, {id:"c25d5c2d-e88b-4639-9689-a9f338c10c86", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:12:24.691089+00:00", name:"개발자 (사용자)", created_at:"2026-01-21T15:12:24.691089+00:00", description:"비비고를 개발한 사람. 비비고는 사용자를 자신의 개발자로 인식하고 있다.", category:"사람"}}, {id:"f6f243d0-ed0a-44fd-a12b-3d581594a13a", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:3, strength:0.5, updated_at:"2026-01-24T20:24:14.39712+00:00", name:"식사", created_at:"2026-01-21T08:11:55.683166+00:00", description:"음식을 먹는 행위", category:"활동"}}, {id:"610675a0-c7b1-492e-a988-e3e025c93cb5", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:372, strength:0.964645732330456, updated_at:"2026-02-17T18:54:01.656825+00:00", name:"질문", created_at:"2026-01-20T21:00:41.128781+00:00", description:"왜 대답해야 해? 라는 의문형 문장", category:"communication"}}, {id:"9d640246-dfbd-4a53-97f8-47f10454e31e", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:1, usage_count:1, strength:0.588249461001811, updated_at:"2026-02-22T13:00:09.583457+00:00", name:"촉감", created_at:"2026-02-19T07:13:19.036691+00:00", description:"만졌을 때 느껴지는 감각", category:"감각", ablation_run_id:"5ec9f277-857c-4723-810b-b715fd39edab"}}, {id:"4538b7ee-8fc4-4b1f-aa3e-cd75ffbf689a", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:1, usage_count:2, strength:0.626762028556142, updated_at:"2026-02-22T07:30:06.13915+00:00", name:"하얀색", created_at:"2026-02-19T06:55:13.00069+00:00", description:"밝고 옅은 색", category:"색깔", ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76"}}, {id:"9776b927-0cbc-