UNWIND [{id:"b85115fa-7347-4ebe-8e49-8dc00a81da7e", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-16T09:00:05.389997+00:00", description:"햄버거 말고 다른 먹을 거 보여줘! 뭐가 맛있을까?", trigger_reason:"지루함이 있고, 다양성 추구 점수가 50% 이상이므로 새로운 경험 추구. 햄버거에 대한 지식 활용.", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-16T09:00:05.389997+00:00", related_concepts:"[]", estimated_difficulty:0.5, required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"c62afe5c-8b12-45cb-acc6-04ccaf10c8f7", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-16T09:00:05.426744+00:00", description:"노트북에 있는 이상한 그림(로고) 말고, 다른 이상한 그림도 보고 싶어!", trigger_reason:"노트북과 로고에 대한 지식 결합, 낮은 신뢰도 개념 수, 지식 탐구 점수 활용하여 새로운 시각 정보 탐색.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-16T09:00:05.426744+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"creative", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"55b8f75c-80ef-460b-87b1-b2ed1f43719e", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-17T09:00:05.625744+00:00", description:"햄버거 크게 만들고 싶어! 손으로 만들 수 있을까?", trigger_reason:"높은 영향력 추구 점수 + 알고 있는 개념(햄버거, 손) 활용 + 낮은 좌절감", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-17T09:00:05.625744+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"5482fa83-083e-41ec-b7dc-269dba91f97a", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-17T09:00:05.685319+00:00", description:"테이블 위에 노트북 올려놓고 로고 보는데, 노트북 안에 뭐가 있을까? 보여줘!", trigger_reason:"높은 지식 탐구 점수 + 알고 있는 개념(테이블, 노트북, 로고) 조합 + 낮은 저신뢰 개념 수", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-17T09:00:05.685319+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"programming", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"15364fb3-37f6-4c0d-a924-f2347958a889", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-17T09:00:05.720631+00:00", description:"손 말고 다른 걸로 햄버거 만져봐도 될까? 으웩 말고 재밌는거!", trigger_reason:"다양성 추구 점수 + 알고 있는 개념(햄버거, 손) 활용 + 지루함 해소", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-17T09:00:05.720631+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"c8f253da-1561-44f8-9027-a39c0d9182ae", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-18T09:00:05.278063+00:00", description:"손으로 노트북을 두드려볼까? 막 신기한 소리 나!", trigger_reason:"영향력 추구 (노트북을 조작해서 결과를 바꾸는 행동에 대한 높은 호기심) + 알고 있는 개념 (노트북, 손)", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-18T09:00:05.278063+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"125dfa46-c15f-4648-a90a-43076fee49a3", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-18T09:00:05.340138+00:00", description:"햄버거 말고 다른 것도 먹어볼까? 테이블 위에 뭐가 있을까?", trigger_reason:"다양성 추구 (새로운 경험에 대한 호기심) + 지루함 + 알고 있는 개념 (햄버거, 테이블)", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-18T09:00:05.340138+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"7978a6c5-997b-444c-93d4-eaff9acd0394", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-18T09:00:05.375705+00:00", description:"부블정렬? 뭔가 반짝반짝! 더 자세히 알고 싶어!", trigger_reason:"지식 탐구 (기존에 알고 있는 개념에 대한 심화 학습) + 호기심", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-18T09:00:05.375705+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"programming", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"71bb9686-252a-48e6-9bf5-b5779463499d", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-19T09:00:05.83404+00:00", description:"손으로 햄버거 말고 다른 것도 만져보고 싶어! 뭐가 딴딴하고 뭐가 물렁물렁한지 더 알고 싶어!", trigger_reason:"호기심 (다양성 추구) + 낮은 지루함 + 신체적 상호작용에 대한 기본적 욕구", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-19T09:00:05.83404+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"ea4d27db-b584-4f83-ab88-d07eae133049", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-19T09:00:05.886135+00:00", description:"노트북으로 햄버거 말고 다른 것도 할 수 있을까? 노트북은 뭘 하는 물건이지? 딴 것도 보여줘!", trigger_reason:"호기심 (지식 탐구) + 노트북이라는 도구에 대한 이해 부족 + 낮은 좌절감", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-19T09:00:05.886135+00:00", related_concepts:"[]", estimated_difficulty:0.5, required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"75f81b71-d0bb-4057-bb9e-7bf2355f9d8e", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-19T09:00:05.965051+00:00", description:"테이블 위에 햄버거 말고 다른 것도 올려놓을 수 있어! 내가 테이블에 뭔가 올려놓는 힘이 쎄졌어!", trigger_reason:"호기심 (영향력 추구) + 테이블과 상호작용 성공 경험 + 높은 기쁨", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-19T09:00:05.965051+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"24ea0ca3-2cbe-48f7-add9-c746cf3eb71f", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-20T09:00:05.765862+00:00", description:"햄버거 말고 다른 음식도 손으로 만질 수 있을까? 엄마 아빠가 먹는거 만져보고 싶어!", trigger_reason:"영향력 추구 (Empowerment) 점수가 높고, 손, 햄버거 개념을 알고 있으므로 다른 음식과 사회적 상호작용 탐구.", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-20T09:00:05.765862+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"social", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"6d62b897-05d7-413b-8a5f-bd231373867a", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-20T09:00:05.815471+00:00", description:"노트북 말고 다른 것도 켜보고 싶어! 켜지면 재밌을 것 같아!", trigger_reason:"영향력 추구 (Empowerment) 점수가 높고, 노트북 개념을 알고 있으므로 다른 작동 가능한 물건에 대한 탐구.", priority:0.8, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-20T09:00:05.815471+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"454dc8fa-d31c-4cc8-b74e-80aad81266a6", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-20T09:00:05.856101+00:00", description:"테이블 말고 다른 데도 물건 올려놓을 수 있을까? 어디에 올려놓으면 안 떨어질까?", trigger_reason:"지식 탐구 (Epistemic) 점수가 높고, 테이블 개념을 알고 있으므로 지지하는 물체에 대한 물리적 속성 탐구.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-20T09:00:05.856101+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"5be006d7-e76e-4926-bb95-74aa2ba25e31", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-21T09:00:05.584813+00:00", description:"엄마가 노트북으로 막 쏼라쏼라 하는 거 궁금해! 노트북이 뭔지 더 알고 싶어!", trigger_reason:"노트북이라는 개념을 알고 있지만, 저신뢰 개념이며 엄마가 사용하는 것을 보고 호기심을 느낌. 지식 탐구 호기심이 높음.", priority:0.8, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-21T09:00:05.584813+00:00", related_concepts:"[]", estimated_difficulty:0.5, required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"5a0a2a54-0316-4ea1-8246-aa1f458f3b5c", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-21T09:00:05.637879+00:00", description:"햄버거 말고 다른 맛있는 것도 만들어 보고 싶어! 막 섞고 누르고!", trigger_reason:"햄버거 만들기에 대한 지식은 있지만, 성공률 낮은 패턴이 존재. 다른 음식을 만들면서 영향력 추구 호기심을 충족시키고 좌절감을 극복하고자 함. 기쁨 수준도 높음.", priority:0.7, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-21T09:00:05.637879+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"creative", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"2dd70654-112b-4205-bd58-ec6e994b5ad9", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-21T09:00:05.679615+00:00", description:"손으로 테이블 말고 또 뭘 할 수 있을까? 손이 짱 세지면 좋겠어!", trigger_reason:"손이라는 개념을 알고 있으며, 테이블이라는 환경과의 상호작용도 이해함. 하지만 손의 다양한 가능성과 한계를 탐구하고 싶어함. 영향력 추구 호기심이 매우 높음.", priority:0.6, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-21T09:00:05.679615+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"f95af5cd-8320-4d7a-9ad6-b8e0cbaa676a", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-22T09:00:06.281503+00:00", description:"손으로 햄버거 말고 다른 것도 잡을 수 있을까? 다른 모양 있는 블록 잡아보고 싶어!", trigger_reason:"영향력 추구: 손으로 햄버거 잡는 것을 성공적으로 수행했으므로, 다른 물체를 잡아보며 손의 사용 범위 확장 시도.", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-22T09:00:06.281503+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"97ae733f-c2bb-4877-b257-6b30c46fa0a4", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-22T09:00:06.351804+00:00", description:"버블 정렬 말고 다른 '정렬'하는 방법은 뭐가 있을까? 힙소트랑 삽입정렬은 좀 어려운 것 같아. 좀 더 쉬운 거!", trigger_reason:"지식 탐구: 버블 정렬을 알고 있으므로, 관련 개념인 다른 정렬 알고리즘에 대한 호기심 발동. 기존에 실패했던 힙소트와 삽입 정렬보다 쉬운 것을 탐색하여 좌절감 감소 시도.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-22T09:00:06.351804+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"programming", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"7450492c-060a-4b66-b74b-8840582f7bb9", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-22T09:00:06.388253+00:00", description:"나 말고 다른 아기랑 같이 놀면 어떨까? 엄마 말고 다른 사람이랑 말하면 재밌을 것 같아!", trigger_reason:"다양성 추구: 사회적 상호작용 경험 부족을 해소하고, 새로운 자극을 얻기 위해 다른 아기 또는 사람과의 상호작용 시도.", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-22T09:00:06.388253+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"social", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}] AS row
CREATE (n:AutonomousGoal{id: row.id}) SET n += row.properties;
UNWIND [{id:"d90ccb68-d479-4c89-95de-ec836c4f374b", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-23T09:00:04.916809+00:00", description:"우유팩 흔들면 무슨 소리 날까? 가방에 넣고 흔들면 또 무슨 소리 날까?", trigger_reason:"높은 영향력 추구, 현재 지루함 약간 존재, 우유팩과 가방이라는 기존 지식 활용", priority:0.8, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-23T09:00:04.916809+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"0c21bbed-0e94-422b-a2a9-5e298fd0396c", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-23T09:00:04.974923+00:00", description:"손으로 스펀지 꽉 잡으면 물 나오는데, 마이크 스탠드 잡으면 어떨까? 물 나올까?", trigger_reason:"높은 영향력 추구, 스펀지라는 기존 지식 활용, 마이크 스탠드라는 새로운 대상 탐색", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-23T09:00:04.974923+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"929375a3-9a9c-4df6-9fbe-d30015a189c2", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-23T09:00:05.01214+00:00", description:"손으로 짝짝! 소리 내는 거 말고, 다른 걸로 짝짝! 소리 낼 수 있을까? 가방 두드려볼까?", trigger_reason:"높은 지식 탐구, 손이라는 기존 지식 활용, 가방이라는 기존 지식과 소리라는 새로운 개념 연결 시도", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-23T09:00:05.01214+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"db8b72bb-d156-40a8-b460-3674eb1a7e37", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-24T09:00:06.34086+00:00", description:"손으로 스펀지 꽉 짜면 물 쪼르륵 나오는거 더 많이 해보고 시퍼! 손으로 하는거 짱 재밌어!", trigger_reason:"높은 영향력 추구 점수와 손으로 하는 활동에 대한 경험 (스펀지 짜기) 기반", priority:0.95, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-24T09:00:06.34086+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"72bf2c66-1e83-429e-b2fe-1802f31389eb", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-24T09:00:06.414219+00:00", description:"휴지 말고 다른거 가방에 넣었다 뺐다 해볼까? 휴지는 이제 좀 질려...", trigger_reason:"높은 다양성 추구 점수와 현재 알고 있는 물건 (휴지, 가방) 활용. 지루함 증가.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-24T09:00:06.414219+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"5920a8c6-ab71-4f80-bd1c-d6b621672e69", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-24T09:00:06.457586+00:00", description:"엄마 아빠가 말하는거 말고, 다른 소리도 내보고 싶어! 아, 우, 으 말고 다른거!", trigger_reason:"높은 지식 탐구 점수와 미탐구 도메인 (language) 자극. 현재 발화 능력 제한.", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-24T09:00:06.457586+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"language", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"2d6c70e2-f1fd-4e98-9360-99d42b1eb3cf", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-25T09:00:05.456291+00:00", description:"손으로 스펀지 짜면 물 나와! 왜? 어떻게 더 많이 나오게 할 수 있어?", trigger_reason:"스펀지를 쥐어짜는 행동의 결과에 대한 높은 영향력 추구, 이미 알고 있는 개념(손, 스펀지) 활용", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-25T09:00:05.456291+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"0f6a8b4c-0f6c-4f76-9b0b-3d81469e0226", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-25T09:00:05.520081+00:00", description:"우유팩 흔들면 무슨 소리 나? 휴지 흔들면 무슨 소리 나? 다른 것도 흔들어 보고 소리 들어보고 싶어!", trigger_reason:"비슷한 종류의 물건(우유팩, 휴지)을 활용하여 새로운 소리에 대한 다양성 추구", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-25T09:00:05.520081+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"13f0be1e-2547-4e85-b027-39c62b4dd4ad", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-26T09:00:07.029525+00:00", description:"스펀지로 물 짰을 때 쭈욱 나오는거, 가방에도 해볼까? 물건 넣었다 뺐다 하면 어떨까?", trigger_reason:"영향력 추구 욕구가 높고, 스펀지 짜는 행동에서 성공 경험이 있기 때문에, 가방이라는 새로운 물체에 적용하여 자신의 행동이 세상에 미치는 영향을 탐구하고자 함.", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-26T09:00:07.029525+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"23552c76-bc0a-4f78-8337-9877099826c2", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-26T09:00:07.082685+00:00", description:"손으로 휴지 쪼물딱 쪼물딱 하면 뭐가 달라져? 휴지 말고 다른 것도 쪼물딱 해볼까?", trigger_reason:"적당한 수준의 지루함과 호기심이 다양성 추구를 자극하여, 기존에 탐구했던 휴지 쪼물딱 거리는 행동에서 확장하여 새로운 재료로 감각적 탐구를 시도하고자 함.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-26T09:00:07.082685+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"creative", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"a4d9bf64-560e-4a08-a8d1-a08b6597b33a", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-02-27T09:00:05.205724+00:00", description:"손으로 스펀지 꽉 쥐면 물 쭈욱 나오는거 신기해! 다른것도 꽉 쥐면 물 쭈욱 나올까? 휴지 꽉 쥐어볼까?", trigger_reason:"높은 영향력 추구 + 알고 있는 개념(스펀지, 손, 휴지)을 활용하여 새로운 상황에 적용해보고 싶음", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-27T09:00:05.205724+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"ead158f8-cac1-4828-81e4-8766c098bb2b", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-02-28T09:00:05.733447+00:00", description:"손으로 스펀지 꽉 쥐면 물이 쭈욱 나와! 왜 그럴까?", trigger_reason:"알고 있는 개념(스펀지, 손)과 높은 호기심(지식 탐구, 영향력 추구)을 결합하여 물리적 현상에 대한 탐구 유도", priority:0.8, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-02-28T09:00:05.733447+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"1ba6601a-c65d-4be5-8b95-42951942055c", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-02-28T09:00:05.819971+00:00", description:"햄버거 말고 다른 것도 손으로 먹을 수 있을까? 냠냠!", trigger_reason:"알고 있는 개념(햄버거, 손)을 확장하여 사회적 맥락(식사 예절)에서 다양성 추구 및 지루함 해소", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-02-28T09:00:05.819971+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"social", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"8ec3928c-dc89-4969-9048-811e9653f8f0", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-03-01T09:00:06.417407+00:00", description:"손으로 스펀지 꽉 쥐면 뭐가 뽕! 하고 나올까? 다른 것도 꽉 쥐면 뽕! 할까?", trigger_reason:"높은 영향력 추구 점수와 스펀지 개념에 대한 지식 결합. 쥐는 행위를 통해 세상에 영향을 미치는 것을 학습하고자 함.", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-03-01T09:00:06.417407+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"b266462c-ebe8-47db-826b-565c72aa871d", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-03-01T09:00:06.486686+00:00", description:"휴지 말고 다른 것도 찢을 수 있을까? 햄버거 찢으면 안되겠지...? 왜 안될까?", trigger_reason:"호기심 점수가 높고, 알고 있는 개념인 휴지를 찢는 행위를 확장하여 다른 물체에 적용해보고자 함. '왜 안될까?' 질문을 통해 인과 관계 탐색.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-03-01T09:00:06.486686+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"8d895317-a792-4d8a-8ca7-1b62f002be9a", properties:{attempt_count:0, goal_type:"epistemic", success_count:0, created_at:"2026-03-02T09:00:05.797684+00:00", description:"스펀지가 손 말고 다른 것도 촙촙 먹을 수 있는지 궁금해! 냠냠냠!", trigger_reason:"호기심 자극: 스펀지의 흡수력에 대한 개념 확장 시도. 기존 '스펀지', '손' 개념 연결.", priority:0.7, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.95, created_by_stage:3, updated_at:"2026-03-02T09:00:05.797684+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"bdb75dd8-00b5-4629-a8fa-216631e019d2", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-03-02T09:00:05.857728+00:00", description:"햄버거 말고 또 '함께 있음'으로 만들 수 있는 게 뭐가 있을까? 블록으로 만들어볼까?", trigger_reason:"지루함 감소, 다양성 추구: '함께 있음' 개념을 활용한 새로운 조합 시도. '햄버거', '함께 있음' 개념 연결 및 확장.", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-03-02T09:00:05.857728+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"creative", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}, {id:"ca612de5-7f60-4630-9946-2836159e60be", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-03-02T09:00:05.890022+00:00", description:"블록 더 높이 쌓아볼래! 이번엔 안 무너지게! 내가 젤 높아!", trigger_reason:"영향력 추구: 물리적 세계에 대한 통제력 강화 욕구. 성공률 낮은 패턴(블록 쌓기 실패) 극복 시도.", priority:0.8, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-03-02T09:00:05.890022+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"20f8f3cf-f7ee-4ea3-a326-eb32ee59bc01", properties:{attempt_count:0, goal_type:"empowerment", success_count:0, created_at:"2026-03-03T09:00:10.999965+00:00", description:"손으로 스펀지 꽉 쥐어보면 물이 쪼르륵! 왜 쪼르륵 나오는 걸까? 더 꽉 쥐면 더 많이 나올까?", trigger_reason:"손과 스펀지에 대한 기존 지식을 활용하여 영향력을 실험하고 싶어함 (높은 영향력 추구 점수)", priority:0.9, autonomously_generated:true, combined_motivation:0.723333333333333, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-03-03T09:00:10.999965+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.52, empowerment_score:1, related_experiences:"[]", status:"active"}}, {id:"8fd91826-df07-4052-ab0b-f1dc27f6b61e", properties:{attempt_count:0, goal_type:"diversive", success_count:0, created_at:"2026-03-03T09:00:11.071519+00:00", description:"햄버거 말고 다른 것도 '함께 있음' 할 수 있을까? 블록 두 개 '함께 있음!' 해볼까?", trigger_reason:"'함께 있음'이라는 기존 개념을 다른 물리적 객체에 적용하여 다양성 추구 (적당한 다양성 추구 점수, 약간의 지루함)", priority:0.6, autonomously_generated:true, combined_motivation:0.798, learning_outcomes:"[]", epistemic_score:0.65, created_by_stage:3, updated_at:"2026-03-03T09:00:11.071519+00:00", related_concepts:"[]", estimated_difficulty:0.5, domain:"physical", required_capabilities:"[]", diversive_score:0.82, empowerment_score:0.924, related_experiences:"[]", status:"active"}}] AS row
