, emotional_salience:0.4, created_at:"2026-02-24T14:00:03.562799+00:00", memory_strength:0.105998394185832, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"505f4dfe-c653-416d-9d31-de2bc030a25b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-28T10:00:03.053175+00:00", memory_strength:0.0533883660636677, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"fc8198eb-503b-4364-85cc-a63c764cda0b", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:18:12.218217+00:00", memory_strength:0.089367996767086, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"한국 수도요? 비비는 아직 아는 게 별로 없는데... 에헤헤! 개발자님이 찾아보라는 거 열심히 해볼게요! 한국 수도가 어디일까? 너무 궁금해요!", task:"한국의 수도가 어디야? 찾아봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"c849c41b-6877-4449-b781-f4b2c54390fb", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-20T06:00:04.785393+00:00", memory_strength:0.0749761427375628, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
