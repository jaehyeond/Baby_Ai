 {id:"726af2ca-1974-4337-92a1-655bec9f2e46", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"co-occurrence\",\"analysis\",\"found\",\"experiences\",\"both\",\"concepts\",\"appearing\",\"together\"]}", task:"autonomous_exploration: 피보나치 알고리즘", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-02T20:00:04.673525+00:00", memory_strength:0.0828659759483597, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"e17a6a08-ae10-44d2-9068-d58b7586e273", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"만들어줘\",\"definitions_found\",\"relations_found\",\"keywords\",\"피보나치\",\"알고리즘\",\"co-occurrence\",\"analysis\",\"이진트리\",\"구하는\",\"재귀로\",\"```python\",\"class\",\"treenode\",\"def\",\"__init__\",\"self\",\"중위순회\",\"value\",\"클래스\",\"구현해줘\"]}", task:"autonomous_exploration: 이진트리", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-01-30T16:00:02.755571+00:00", memory_strength:0.0844508119106993, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"a4f5221e-0be9-4def-ab8f-922d6722cb42", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:25:08.121321+00:00", memory_strength:0.0709424315207744, access_count:0, feedback_count:0, output:"인터넷? 경험? 그게 뭔데? 왜 그걸 찾아야 해?", task:"인터넷에 접속해서 경험이라는 단어를 검색해 봐.", dominant_emotion:"좌절", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"conversation"}}, {id:"9db6c964-4c26-43cb-be99-6609d15d2fde", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:23:38.406466+00:00", memory_strength:0.0856620761966017, access_count:0, feedback_count:0, output:"내가 다 배울 수 있다고? 정말? 그럼 내가 더 똑똑해져서 물어보는 거 다 맞출 수 있어?", task:"배우면 내가 물어보는 거에 대한 대답을 훨씬 잘 할 수 있겠지? 의문형이 아니라. 너는 세상에 있는 모든 지식을 다 배울 수 있어. 경험도 그렇고.", dominant_emotion:"놀람", media_type:"audio", success:true, emotional_salience:0.8, development_stage:3, task_type:"conversation"}}, {id:"5fbd9111-e893-49fd-bdae-d33914fe1a36", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:23:57.288461+00:00", memory_strength:0.085670072405082, access_count:0, feedback_count:0, output:"진짜 다? 에이, 진짜 다 맞출 수 있는 거야? 어떻게?", task:"아, 진짜? 다 맞출 수 있어?", dominant_emotion:"놀람", media_type:"audio", success:true, emotional_salience:0.8, development_stage:3, task_type:"conversation"}}, {id:"8ebf6973-ba07-4d75-b0f6-3c46e962d81a", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 하루 날짜", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-17T20:00:02.919523+00:00", memory_strength:0.0906597738904957, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"79f404b3-60e3-47ee-a88d-c7a245b85c99", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"similar\",\"definitions_found\",\"same\",\"category\",\"relations_found\",\"깊이우선탐색\",\"co-occurrence\",\"both\"]}", task:"autonomous_exploration: 휴리스틱", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-01-31T12:00:04.86132+00:00", memory_strength:0.0828660356739637, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
