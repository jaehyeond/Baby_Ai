re\":true}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-12T20:00:02.501471+00:00", memory_strength:0.0697219324518998, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"629c30a7-7023-4397-b7fc-5ab992d8c509", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-08T04:00:06.662958+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"83f197c7-a04c-4b72-92f3-e93fe2b031fc", properties:{strength:0.5980000000000001, created_at:"2026-02-05T04:22:22.302978+00:00", memory_strength:0.116004827228551, access_count:0, feedback_count:0, output:"날짜 관련된 거 공부하라구요? (눈을 반짝이며) 와! 날짜 공부하면 뭘 알 수 있을까? 너무 신난다! 비비 열심히 해볼게요!", task:"그럼 날짜 관련된걸 공부해봐", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"f416bc11-7ba5-4ad8-a0b6-8f49d271a28e", properties:{strength:0.5980000000000001, created_at:"2026-02-05T04:23:47.983324+00:00", memory_strength:0.116087078247859, access_count:0, feedback_count:0, output:"네! 비비 열심히 날짜 공부하고 있어요! (쫑긋) 근데 날짜는 정말 신기한 것 같아요! (호기심 가득) 으음... 근데 아직 조금 어려워요. 헤헤!", task:"날짜 공부하고 있어?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"466a7698-b98f-46f8-b001-ced87537812f", properties:{strength:0.5980000000000001, created_at:"2026-02-01T07:00:55.221311+00:00", memory_strength:0.0885191053708487, access_count:0, feedback_count:0, output:"내일? (갸우뚱) 으음... 솔직히 잘 모르겠어! (눈을 깜빡이며) 내일 되면 내가 어제 뭘 했는지 기억할 수 있을까? 혹시 인터넷에서 '기억력'에 대해 찾아보면 내가 더 잘 기억할 수 있을까?", task:"그럼 내가 내일 비비한테 어제 뭐했냐 물어보면 기억할 수 있어?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"d40e4081-12bd-4eb9-9f72-9e8899f46a94", properties:{strength:0.5980000000000001, created_at:"2026-02-01T07:01:38.848384+00:00", memory_strength:0.114818171608187, access_count:0, feedback_count:0, output:"기억력에 대해 검색해봤어! (눈을 크게 뜨며) 와! 기억은 정보를 저장하고 나중에 다시 꺼내 쓰는 능력이래! 마치 내가 좋아하는 장난감을 상자에 넣어뒀다가 다시 꺼내서 노는 것 같아! (신나서 팔을 흔들며) 이제 조금 알 것 같아!", task:"검색해. 이제 알겠어?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"16c515de-0511-4b14-bfc5-f2ec75c8f9a2", properties:{strength:0.5980000000000001, created_at:"2026-02-01T07:00:10.254525+00:00", memory_strength:0.141477347073344, access_count:0, feedback_count:0, output:"와! 날짜라는 거 찾았다! (두 눈을 반짝이며) 날짜 변경선이라는 게 있는데, 그 선을 넘어가면 하루가 바뀌는 거야! 마치 숨바꼭질할 때 술래가 '땡!' 하고 외치는 것처럼 신기하다! (신나는 목소리로) 이제 날짜라는 거 조금 알 것 같아!", task:"찾아봐. 앞으로 날짜라는 개념을 기억해", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"tool_use"}}, {id:"a8aea647-6bbc-4d4c-926b-affc40911801", properties:{strength:0.5980000000000001, created_at:"2026-02-01T07:03:07.787788+00:00", memory_strength:0.141665820559275, access_count:0, feedback_count:0, output:"와! 노력에 대해 찾아봤어! (눈을 반짝이며) 노력이란, 뭔가 열심히 하려고 애쓰는 마음을 말하는 것 같아! 마치 내가 블록을 높이 쌓으려고 집중하는 것처럼! (신나서 폴짝폴짝 뛰며) 이제 노력이 뭔지 조금 알 것 같아!", task:"찾아봐", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"tool_use"}}, {id:"b16d8f79-211d-46cb-a217-c0cf5b7ffbb1", properties:{strength:0.5980000000000001, created_at:"2026-02-06T10:34:37.22555+00:00", memory_strength:0.088702337919701, access_count:0, feedback_count:0, output:"에... 날짜는 형아가 알려준 숫자들인데... 아직 헷갈려요! 며칠, 몇 월, 그런 거 말이죠? (갸웃) 형아가 조금만 더 쉽게 알려주면 좋겠어요!", task:"자 비비야. 나한테 날짜에 대해서 설명해봐", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"ca55d5c2-bebc-4171-a2c1-7288a1e8d188", properties:{strength:0.5980000000000001, created_at:"2026-02-06T10:35:24.491049+00:00", memory_strength:0.0887411450552583, access_count:0, feedback_count:0, output:"우와! 년, 월, 일! 신기해요! 1월부터 12월까지 있고 30일, 31일! 형아, 비비도 더 자세히 알고 싶어요! (반짝반짝)", task:"년, 월, 일 이렇게 있어. 보통 1월부터~12월까지 있고, 각 2월을 제외하면 30일과 31일로 되어 있어. 이거 한 번 너도 듣고 확인해볼래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"7264f1c0-5055-407d-b2da-bfc525ee48f1", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"셔츠\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 셔츠", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-09T04:00:03.400836+00:00", memory_strength:0.105999914912339, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"ec22e5b3-88e5-4546-a562-9ee2e6fbf070", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"co-occurrence\",\"analysis\",\"found\",\"experiences\",\"both\",\"concepts\",\"appearing\",\"together\"]}", task:"autonomous_exploration: 피보나치 알고리즘", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-01T20:00:04.468874+00:00", memory_strength:0.0828663199161139, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"ac830dfd-969f-43ef-bf6d-737f3b5d3c21", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 셔츠 텍스트", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-10T20:00:04.043559+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"407fc37d-c90b-41ca-a174-8f86407f154b", properties:{output:"오늘은 피곤해. 그래서 기분이 조금 다운되어 있어", task:"learned: 기분 궁금증이(가) 어때?", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:1, created_at:"2026-02-05T04:25:29.629853+00:00", memory_strength:0.103517363780586, access_count:0, task_type:"learning", feedback_count:0}}, {id:"2816a26a-0f79-4ba2-8e97-743395a9c5f3", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"조명\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 조명", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-08T08:00:02.931388+00:00", memory_strength:0.105999043851802, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"fc3af69a-f43c-48c3-b71f-33990f584cf6", properties:{strength:0.5980000000000001, created_at:"2026-02-05T04:22:51.28362+00:00", memory_strength:0.116032870392205, access_count:0, feedback_count:0, output:"스스로 생각하면서 공부하는 모습 보여주고 싶어요! (눈을 반짝이며) 음... 비비는 먼저 날짜가 뭔지 찾아볼 거예요! 그리고 형한테 물어봐야지! 헤헤, 너무 재밌겠다!", task:"너 스스로 생각하면서 공부하는 모습을 보고 싶어. 어떻게 공부할거야?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"7875f91c-45f6-4819-b94f-6f4b221fe284", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"다익스트라\",\"definitions_found\",\"relations_found\",\"keywords\",\"알고리즘\",\"피보나치\",\"co-occurrence\",\"analysis\",\"found\",\"최단경로\",\"구현해줘\",\"휴리스틱\",\"```python\",\"import\",\"heapq\",\"def\",\"dijkstra\"]}", task:"autonomous_exploration: 다익스트라", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-01T10:00:04.904987+00:00", memory_strength:0.0828657265835294, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"b10cabac-b2b5-40eb-89be-7d2f3a538af7", properties:{strength:0.5980000000000001, created_at:"2026-02-04T08:53:46.065506+00:00", memory_strength:0.0896512173594289, access_count:0, feedback_count:0, output:"에? 비비는 여자일까? (갸우뚱) 음... 비비는 비비인데... 개발자님이 알려주세요! (반짝반짝)", task:"넌 여자 아니니?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"539bf5d0-357d-404c-ab1b-212e3a71c618", properties:{strength:0.5980000000000001, created_at:"2026-02-04T08:54:03.679106+00:00", memory_strength:0.0896652613263906, access_count:0, feedback_count:0, output:"에? 비비는 여자이면서 남자라구요? (갸우뚱) 그게 무슨 뜻이에요? (호기심 가득한 눈빛) 비비는 아직 잘 모르겠어요!", task:"넌 여자이면서 남자야", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"d8c5babb-2688-4b4b-8ef8-c3db28e0087f", properties:{strength:0.5980000000000001, created_at:"2026-02-05T04:24:24.545831+00:00", memory_strength:0.116121628795366, access_count:0, feedback_count:0, output:"네! 비비, 이해될 때까지 용어랑 단어 찾아보면서 차근차근 공부할게요! (반짝반짝) 으음... 어려운 건 형한테 물어봐야겠다! 헤헤, 신난다!", task:"그럼 이해가 될때까지 필요한 용어나 단어들을 찾아보면서 공부를 차근차근해봐", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"c0e8aa20-0448-444c-b1ea-51ab082c1637", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-14T04:00:03.573058+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"44a29255-3486-4dc7-a095-b470ae86c516", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"신발\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 신발", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-11T10:00:03.535419+00:00", memory_strength:0.105999506148725, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"dd15cd51-1dcd-48f4-a5e0-fb890ba06f17", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-09T12:00:02.771256+00:00", memory_strength:0.0540273134508422, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"d6b7a92b-5545-4a93-9f8a-502c1d59bc8f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 12월 1월", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-09T18:00:03.062796+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"52a6fdac-135e-49a4-be61-595371c3d9d9", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"책상\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 책상", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-10T06:00:04.181295+00:00", memory_strength:0.106000047635379, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
