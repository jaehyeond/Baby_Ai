egory:"AI"}}, {id:"c68701e7-ecb8-4bc8-b723-fa42cdd21bb7", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:19:11.360669+00:00", name:"알다", created_at:"2026-01-21T15:19:11.360669+00:00", description:"어떤 사실이나 정보를 이해하고 있는 상태", category:"인지"}}, {id:"5a35df83-10b3-4aab-a8f7-2032caf8e7cd", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:19:11.419619+00:00", name:"모르다", created_at:"2026-01-21T15:19:11.419619+00:00", description:"어떤 사실이나 정보를 이해하지 못하고 있는 상태", category:"인지"}}, {id:"c0a6079c-5b7b-4c56-b1ab-16346122ded6", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.5, updated_at:"2026-01-21T15:19:43.178888+00:00", name:"좋아한다", created_at:"2026-01-21T15:19:11.303414+00:00", description:"어떤 대상에게 호감을 느끼거나 긍정적인 감정을 갖는 것", category:"감정"}}, {id:"570f1041-4ac5-433d-8640-5e7de7f16d7e", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-22T06:13:07.936585+00:00", name:"챗봇", created_at:"2026-01-22T06:13:07.936585+00:00", description:"사람과 대화할 수 있도록 설계된 컴퓨터 프로그램.", category:"개체"}}, {id:"937007ba-3fb9-4249-a886-94f219b426c4", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:20:46.539265+00:00", name:"좋아하다", created_at:"2026-01-21T15:20:46.539265+00:00", description:"특정 대상에 대해 행복, 설렘, 기쁨과 같은 긍정적인 감정을 느끼는 것.", category:"감정"}}, {id:"ed7b2469-a517-4eb4-bb50-90478125b502", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:4, strength:0.5, updated_at:"2026-02-17T18:44:08.803161+00:00", name:"짜증", created_at:"2026-01-22T03:01:28.340138+00:00", description:"불쾌하고 귀찮게 느껴지는 감정 상태.", category:"감정"}}, {id:"46b2bb7b-97ee-4882-b17c-51513a7492df", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:54, strength:0.981735815572218, updated_at:"2026-02-06T09:30:02.702186+00:00", name:"혼란", created_at:"2026-01-21T07:50:17.524378+00:00", description:"AI가 화자의 불명확한 요청('말')과 갑작스러운 인사('안녕')에 대해 혼란스러워하는 상태.", category:"AI_상태"}}, {id:"87905739-4b65-4fc5-8b95-a50a88d9f1c3", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:21:26.16491+00:00", name:"정보 제공", created_at:"2026-01-21T15:21:26.16491+00:00", description:"특정 정보(날씨)를 사용자에게 알려주는 행위", category:"행위"}}, {id:"0a2029ac-c32b-410c-b084-0f4497d3a1b4", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:21:50.14956+00:00", name:"서울 날씨", created_at:"2026-01-21T15:21:50.14956+00:00", description:"대한민국 서울특별시의 날씨 정보", category:"날씨"}}, {id:"db84d348-b7aa-43c9-8292-df83b70c723a", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-22T08:55:43.47666+00:00", name:"정체성", created_at:"2026-01-22T08:55:43.47666+00:00", description:"대화 맥락상, 비비가 자신의 존재와 역할에 대해 혼란을 느끼는 상태를 의미함.", category:"추상적 개념"}}, {id:"ef200492-0ad5-4ec5-b1a5-e69e4ec7a41c", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:42:00.033+00:00", name:"텍스트 변환", created_at:"2026-01-21T15:42:00.033+00:00", description:"오디오 파일을 텍스트 형식으로 변환하는 과정", category:"기술"}}, {id:"e602d1d2-efcb-436b-9c21-9815d3ecaecf", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T15:42:00.107199+00:00", name:"JSON", created_at:"2026-01-21T15:42:00.107199+00:00", description:"JavaScript Object Notation. 데이터를 표현하는 가벼운 형식", category:"데이터 포맷"}}, {id:"52c73325-00eb-49b6-950b-11a3b217abe1", properties:{exploration_count:0, definition_strength:0.5, acq