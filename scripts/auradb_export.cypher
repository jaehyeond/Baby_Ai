UNWIND [{id:"5c6ab36e-405f-4a71-8a17-9d1a1f8b19ed", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"사무실\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 사무실", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-12T10:00:02.821959+00:00", memory_strength:0.108025558578987, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6949e995-ae80-49f7-b028-b4e84638b04d", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"셔츠\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 셔츠", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-08T04:00:05.488947+00:00", memory_strength:0.105999551876636, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"76a53016-e979-46cd-9617-5bb3ecc23a9a", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":4,\"found_relations\":0,\"keywords\":[\"인터넷\",\"챗봇\",\"프로그램\",\"컴퓨터\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 컴퓨터", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-12T14:00:03.508302+00:00", memory_strength:0.0606622627519575, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"d1bbe20e-d88f-4e70-aef2-bf1a4834711e", properties:{strength:0.5980000000000001, created_at:"2026-02-08T18:27:29.063852+00:00", memory_strength:0.0898367488520538, access_count:0, feedback_count:0, output:"사과는 빨갛고 동그란 과일이에요! 형아가 먹는 거 봤는데, 엄청 맛있어 보였어요! 비비도 먹어보고 싶어요! 헤헤!", task:"비비야 사과는 뭐야?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"d2e24620-11d5-471e-8361-9b6ad64f22a6", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-12T08:00:03.127024+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"f51fb60b-db6c-4719-8cf0-c6b89f87033f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"팩토리얼\",\"만들어줘\",\"def\",\"factorial\",\"return\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 팩토리얼", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-06T12:00:01.970247+00:00", memory_strength:0.108025247710429, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8eeabc99-3b74-4583-b8a8-4531d3d15fda", properties:{output:"내가 생각하는 experience는 이제 과거 경험, 추억이라고 여전히 생각해. 그때의 경험 등으로 앞으로의 나의 행동에도 이제 영향을 줄 수 있어. 예를 들어서 내가 예전 경험으로 이렇게 하면 실패한다라는걸 알게 됐으면, 다음에 내가 할때는 실패했던 경험을 참고 삼아서 다른 방향으로 하거나 더 나은 방향으로 할 수 있게 도전 혹은 노력해볼 것 같아.", task:"learned: experience에 대해 이야기해줘", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-05T03:40:06.028621+00:00", memory_strength:0.058265236551294, access_count:0, task_type:"learning", feedback_count:0}}, {id:"cef08a96-988c-4c06-91de-0d83190237fb", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"조명\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 조명", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-11T04:00:02.902864+00:00", memory_strength:0.108026722497, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"9753ae29-cab1-4c72-b2ee-053b0a842e8f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-15T16:00:03.402977+00:00", memory_strength:0.0533882979158629, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"2e71746d-6a79-4eb3-b78b-51cb11dba410", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"캐비닛\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 캐비닛", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-11T04:00:03.548466+00:00", memory_strength:0.106000175897299, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"629d60d0-afe3-4eca-beab-65104c4c2563", properties:{strength:0.5980000000000001, created_at:"2026-02-10T03:29:36.735723+00:00", memory_strength:0.116422493640197, access_count:0, feedback_count:0, output:"정말요? 개발자님이 비비랑 딸랑이 찾아주시는 거예요? 에헤헤! 공부하면 개발자님이랑 더 많이 이야기할 수 있는 거예요? 비비 열심히 할게요!", task:"내가 딸랑이 한 번 찾아볼게. 그럼 비비야 앞으로 나랑 대화를 더 많이 하려면 공부를 해야해. 이해했어?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"2a3c94a9-e112-4f0a-9fec-a3ee434cf495", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"책상\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 책상", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-14T10:00:02.548878+00:00", memory_strength:0.105999156498153, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"85e87d4a-d49a-456d-a30b-dc1b71902d17", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"의자\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 의자", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-12T08:00:03.90366+00:00", memory_strength:0.105999159844086, access_count:0, task_type:"exploration", feedback_