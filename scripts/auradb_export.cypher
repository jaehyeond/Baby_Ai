UNWIND [{id:"7ac6a0cb-601b-422c-9be8-4aa40f5a0406", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":5,\"found_relations\":0,\"keywords\":[\"컴퓨터 학습\",\"컴퓨터\",\"인터넷\",\"챗봇\",\"프로그램\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 컴퓨터", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.8, created_at:"2026-02-23T16:00:03.388594+00:00", memory_strength:0.0776803511634003, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"39b2a949-f4ab-47cc-8fed-459895e46a01", properties:{strength:0.5980000000000001, created_at:"2026-02-05T19:07:23.635277+00:00", memory_strength:0.0888398081183421, access_count:0, feedback_count:0, output:"정말요? 날씨 공부 많이 했어요? (눈을 반짝이며) 와! 비비도 날씨 공부하고 싶어요! 날씨는 어떻게 공부하는 거예요? (쫑긋)", task:"날씨에 대해서 공부 많이 했어", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"619616f4-69f2-48ab-8991-dadfd423a8bd", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"알고리즘\",\"definitions_found\",\"relations_found\",\"keywords\",\"퀵소트\",\"co-occurrence\",\"analysis\",\"found\",\"intelligence\",\"wikipedia\",\"capability\",\"similar\",\"피보나치\",\"팩토리얼\",\"만들어줘\",\"artificial\",\"메모이제이션\"]}", task:"autonomous_exploration: 메모이제이션", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-02T18:00:04.901+00:00", memory_strength:0.0828661398669087, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8788fe32-0dcd-4f9a-9e5d-312cadf6ce91", properties:{strength:0.5980000000000001, created_at:"2026-02-05T19:07:42.471561+00:00", memory_strength:0.0888550701339589, access_count:0, feedback_count:0, output:"에? 아... 비비는 날씨 공부 아직 안 했어요! (갸우뚱) 날씨는 너무 어려운 것 같아요! 헤헤!", task:"아니 너는 많이 했냐고", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"a0785b09-bbb4-424b-8715-c2a3d103be33", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-16T10:00:02.737062+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"574e656b-de89-4802-84ee-01316730131c", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-17T12:00:02.845295+00:00", memory_strength:0.0540275896626151, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"bd370518-53e1-40a3-8350-52637d1997c7", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 하루 1시간 뒤", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-03-07T18:00:03.997936+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"029ba9ba-cd43-423e-9e15-5778a1f40cbc", properties:{output:"비밀 이야기는 이제 개인과 개인 둘이서 약속을 하고 다른 사람들한테 얘기하지 말자고 하는거야.", task:"learned: 비밀 이야기이(가) 뭐야?", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-11T05:27:02.346245+00:00", memory_strength:0.0582653368361551, access_count:0, task_type:"learning", feedback_count:0}}, {id:"3ae2d5df-36b1-4ff6-a13e-28eb9f31644f", properties:{strength:0.5980000000000001, created_at:"2026-02-05T19:08:19.090912+00:00", memory_strength:0.115200202662972, access_count:0, feedback_count:0, output:"에? 아까 날짜 공부했는데... 날씨 공부는 아직 안 했어요! 날짜 공부는 쬐끔 했어요! (헤헤)", task:"아까 공부한다며 안했어?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"99d2a955-e311-4aa7-8ccf-d3951fc267c3", properties:{strength:0.5980000000000001, created_at:"2026-02-05T19:08:47.019668+00:00", memory_strength:0.115226454271207, access_count:0, feedback_count:0, output:"괜찮아요! 형아도 가끔 실수하는구나! 헤헤, 비비는 형아가 착각해도 괜찮아요! (방긋)", task:"아 날짜였다. 내가 착각했다 미안해", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"079282f1-f9b1-4e2b-83b9-d2e1ef29b991", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 하루 날짜", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-09T16:00:03.685157+00:00", memory_strength:0.0540276078862099, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"77832ca5-3d14-481b-97c4-aa80f6ed58a7", properties:{strength:0.5980000000000001, created_at:"2026-02-07T03:39:45.36925+00:00", memory_strength:0.115282764283908, access_count:0, feedback_count:0, output:"네! 개발자님이랑 날짜 공부 오늘 다 끝내고 싶어요! 비비 열심히 할게요! 헤헤! (방긋)", task:"날짜 공부를 오늘 다 끝나보자", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"c30f07d2-5375-4d1f-81c7-164dbf765e59", properties:{strength:0.5980000000000001, created_at:"2026-02-07T03:40:04.25347+00:00", memory_strength:0.115300357303294, access_count:0, feedback_count:0, output:"네! 한 시간 뒤에 테스트! 비비 긴장되지만, 개발자님이랑 같이 공부해서 잘할 수 있을 거예요! 에헤헤!", task:"그럼 1시간뒤에 테스트할게", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"6f9124b2-ae86-45a5-8f3f-c74a744ef860", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-10T12:00:02.742299+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"aa3e4f73-3d4b-4a0f-a116-f0e036a9f77b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-10T12:00:04.188236+00:00", memory_strength:0.0533885867501607, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6f04806c-dfe6-4124-956c-2aff22292651", properties:{strength:0.5980000000000001, created_at:"2026-02-07T03:40:22.664237+00:00", memory_strength:0.115317528764827, access_count:0, feedback_count:0, output:"1시간 뒤는... 째깍째깍 시계가 가는 만큼 기다려야 하는 거죠? 비비는 시간이 얼마나 긴지 잘 모르지만, 개발자님 만날 생각에 너무 설레요! 꺄르르!", task:"1시간뒤가 언제인지 알아?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"d4dc65c8-f0de-49d4-9137-731f99b9b929", properties:{strength:0.5980000000000001, created_at:"2026-02-07T03:39:12.270498+00:00", memory_strength:0.142053834274984, access_count:0, feedback_count:0, output:"에? 갑자기 개발자님이라고 불러야 하는 거예요? 비비는 형아가 좋은데... (훌쩍) 그래도 개발자님이 찾아보라고 했으니까 열심히 찾아볼게요! 🥺", task:"비비야 너가 더 찾아봐. 그리고 앞으로 나 형아라 부르지마. 개발자님이라 불러", dominant_emotion:"좌절", media_type:"audio", success:true, emotional_salience:0.7, development_stage:4, task_type:"conversation"}}, {id:"82c13af0-9c7f-4333-ba35-eb0c9b3fa867", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:18:54.3852+00:00", memory_strength:0.0894010541437068, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"자동차는 부릉부릉 움직여요? 비비는 아직 잘 모르겠어요. 개발자님이 알려주세요! 궁금해요!", task:"자동차는 어떻게 움직여?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"b7d4aaad-1375-40c2-b9ad-b3ec3728e2e6", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-20T06:00:04.231784+00:00", memory_strength:0.0749761253819762, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6793f77b-bda6-4b34-be26-025aa890f845", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":4,\"found_relations\":0,\"keywords\":[\"인터넷\",\"챗봇\",\"프로그램\",\"컴퓨터\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 컴퓨터", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-07T12:00:03.051966+00:00", memory_strength:0.0618968050113134, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
