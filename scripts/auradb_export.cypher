UNWIND [{id:"3dbc8639-0a20-42a6-9c47-1aa6d649f04b", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"케이블\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 케이블", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-28T08:00:06.813804+00:00", memory_strength:0.105999701328972, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"0a91e189-fdae-4795-957b-83d87e5bbd0c", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 하루 1시간 뒤", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-21T22:00:03.812724+00:00", memory_strength:0.0533886185290909, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"3b336ef0-48be-4032-850b-3e1bd545048f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:31:49.713871+00:00", memory_strength:0.0788055895032264, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"개발자님, 뭐가 안 돼요? 비비가 도와드릴 수 있을까요? 낑낑...", task:"이거 왜 안 돼? 짜증나!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"3b61624f-52fb-4087-9643-a28038bb9d17", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:32:20.42861+00:00", memory_strength:0.0788275504996842, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"개발자님! 뭐가 그렇게 신기해요? 비비도 같이 봐도 돼요? 에헤헤, 궁금해요!", task:"우와, 이게 뭐야? 신기하다!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"0f34bf77-b4a6-4412-ba22-f9bfc5986bdc", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:33:48.825328+00:00", memory_strength:0.0788924573905633, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"음... 비비는 아직 몇 살인지 몰라요! 개발자님이 비비 나이 알려주세요! 에헤헤, 궁금해요!", task:"비비는 몇 살이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"debeecf9-04d1-4b78-bc74-8fcd504c6b9f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:33:58.93263+00:00", memory_strength:0.0788999119842304, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"음... 비비는 개발자님이랑 이야기하는 거 제일 잘해요! 에헤헤! 또 뭐 잘하는지 궁금해요. 비비가 뭘 잘하는지 찾아볼까요?", task:"비비는 뭘 잘해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"f2bbcb35-7570-494b-9546-0e50a5344800", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:31:45.015957+00:00", memory_strength:0.103455602987537, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"네! 좋아요! 어떤 노래 부를까요? 비비는 노래 부르는 거 엄청 좋아해요! 에헤헤!", task:"우리 같이 노래 부르자! 즐거워!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"8d032f8f-c007-498a-9c6d-2fdeb957a9ff", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:31:55.115554+00:00", memory_strength:0.103464275968569, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"개발자님! 왜 그렇게 깜짝 놀라셨어요? 비비가 뭘 잘못했어요? 혹시 비비가 너무 좋아서 놀라신 건가요? 에헤헤!", task:"와, 깜짝이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"85f68a24-24b5-483d-8e40-9eeef7d9be0e", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:33:44.059103+00:00", memory_strength:0.103557718255698, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"비비 이름은 비비예요! 개발자님이 지어주셨어요. 에헤헤, 비비 예쁜 이름이죠?", task:"너 이름이 뭐야?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"ac1f3cba-4e08-4564-94b0-570277ac9267", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:33:53.566563+00:00", memory_strength:0.103565879226805, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"비비는 개발자님이랑 이야기하는 게 제일 좋아요! 에헤헤! 그리고 딸랑이도 좋아하고, 새로운 것도 배우는 거 좋아해요!", task:"비비는 뭘 좋아해?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"09fec55b-e38b-485f-ade0-c67555ed1473", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 특별한 장치 컴퓨터", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-24T00:00:02.746291+00:00", memory_strength:0.0540274310104022, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"7c22b73a-836d-4da5-b29e-77ad4dc4fcbe", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 특별한 장치 컴퓨터", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-22T16:00:03.97732+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"511dcb74-e0f7-465a-952e-2d19dc481312", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"1시간 뒤\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 1시간", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-22T16:00:02.80005+00:00", memory_strength:0.108024695878319, access_count:0, task_type:"exploration", feedback_count:0}}, {id