UNWIND [{id:"d3b5f165-2ed3-47d5-927f-d5fabf5beea1", properties:{strength:0.5980000000000001, created_at:"2026-01-19T12:16:56.964406+00:00", memory_strength:0.0755512500342436, access_count:0, feedback_count:0, output:"```python\nfrom collections import deque\n\ndef bfs(graph, start):\n    visited = set()\n    queue = deque([start])\n    result = []\n\n    while queue:\n        vertex = queue.popleft()\n        if vertex not in visited:\n            visited.add(vertex)\n            result.append(vertex)\n            queue.extend(neighbor for neighbor in graph[vertex] if neighbor not in visited)\n    \n    return result\n\n# 예제 그래프\ngraph = {\n    'A': ['B', 'C'],\n    'B': ['A', 'D', 'E'],\n    'C': ['A', 'F'],\n    'D': ['B'],\n   ", task:"BFS 너비우선탐색 알고리즘 구현해줘. deque 사용해서.", media_type:"text", success:true, emotional_salience:0.5, embedding:[0.010617268, -0.044773288, -0.032854933, -0.016318215, -0.017668962, 0.01295128, -0.011630328, 0.046719953, -0.066703066, 0.06777572, 0.0032874797, 4.6214665E-4, -0.031285685, -0.05839994, 0.008029992, -0.013596857, 0.0049287365, 0.010329242, 0.013239306, -0.029358882, 0.042945806, 0.006967272, 0.04473356, 0.04461438, 0.020122157, 0.027670449, 0.06646469, 0.029021196, -0.010805976, -0.029557522, -0.04254853, -0.009797881, -0.031126771, -0.013189646, -0.02387644, -0.011372098, -0.011421758, -0.0028628884, 0.016993588, 0.045925397, 0.032457653, -0.030550718, 0.017817942, -0.047395326, -0.015831549, 0.04199234, -0.022188006, 0.014043796, 0.019764606, 0.04604458, 0.044773288, 0.00900829, -0.019268008, 0.033272076, -0.038774382, 0.013785564, -0.016218895, -0.026677253, 0.013954408, 0.058876675, 0.037364043, 0.013338626, -0.010508017, 0.08620944, -0.027531402, 1.7691309E-4, 0.008740127, 0.020876987, -0.029060924, -0.007245367, -0.066623606, 0.024631267, 0.0056661847, -0.023916166, -4.0969346E-4, -0.013189646, 0.021890046, 0.002110542, -0.03345085, 0.0013246755, -0.0038883635, -0.013666381, -0.007205639, -0.043064993, -0.0060336674, -0