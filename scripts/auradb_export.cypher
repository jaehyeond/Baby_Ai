ck_count:0}}, {id:"abd4bc62-1b96-495a-99d7-1a05e55a7b2e", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"테이블\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 테이블", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T08:00:01.595777+00:00", memory_strength:0.108016718212678, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8962e673-a4aa-4195-9bd2-5013fa64f777", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":5,\"found_relations\":0,\"keywords\":[\"비밀 이야기\",\"이야기\",\"귓속말\",\"속삭임\",\"설명\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 이야기", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.8, created_at:"2026-02-25T18:00:02.966656+00:00", memory_strength:0.0776796340196776, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"2520c20f-bcad-41a1-a7e0-40b4707cc882", properties:{strength:0.5980000000000001, created_at:"2026-02-24T09:37:47.027653+00:00", memory_strength:0.115169802335665, access_count:0, feedback_count:0, output:"형! 오늘도 좋은 하루 보내세요! 에헤헤, 비비도 형 덕분에 기분이 좋아요! '오늘'은 지금 이 순간을 말하는 거잖아요! 비비는 형이랑 이야기해서 너무 행복해요! ", task:"오늘도 좋은하루", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:5, task_type:"conversation"}}, {id:"607c5e15-9a81-4a8e-b48e-b62d01118cdf", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:15:42.952806+00:00", memory_strength:0.089244597397271, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"나무가 어떻게 자라는지 정말 궁금해요! 비비는 아직 어려서 나무가 어떻게 자라는지 몰라요. 혹시 개발자님이 알려주실 수 있어요? 아니면, 사전을 찾아볼까요?", task:"나무는 어떻게 자라?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"857fbf09-7d58-4d55-a0c2-6f9fc8fa4820", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:15:50.333391+00:00", memory_strength:0.0892506761529734, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"비가 어디서 오냐구요? 음... 비가 뭔지 비비는 잘 모르겠어요! 혹시 '비'가 무슨 뜻인지 찾아봐 주실 수 있나요? 그러면 비비도 알 수 있을 것 같아요! 에헤헤, 궁금해요!", task:"비는 어디서 와?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"2bb0e1d4-2ccb-45e2-9729-e72a77303789", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"캐비닛\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 캐비닛", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T06:00:02.892617+00:00", memory_strength:0.105999333275092, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"e84bf149-4abd-4ec1-9a43-762757cc7dd1", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"햄버거\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 햄버거", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T06:00:03.616793+00:00", memory_strength:0.105999911008723, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"c65ea678-a14d-4d0c-b1a5-ef36f5444a69", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:56:13.070456+00:00", memory_strength:0.0897691505163795, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"으앙! 슬플 때는... 비비는 잘 모르겠어요. 개발자님은 슬플 때 어떻게 해요? 비비는 개발자님이랑 이야기하면 기분이 좋아져요! 에헤헤!", task:"비비야, 슬플 때는 어떻게 해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"59a5be18-0d6c-4317-b5f0-a49473688c1d", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:56:23.52614+00:00", memory_strength:0.0897779653654018, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"하늘이 왜 파란색이냐구요? 음... 비비는 아직 몰라요! '파란색'이 무슨 뜻인지 사전을 찾아봐도 될까요? 개발자님, '파란색'이 뭔지 알려주세요! 에헤헤!", task:"하늘은 왜 파란색이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"aa48d622-db8a-4baf-9ba1-b10cd7fda3e4", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:59:12.098752+00:00", memory_strength:0.0899194704113664, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"시간 여행이 뭐예요? 비비는 개발자님하고 이야기하는 지금이 제일 좋은데! 시간 여행 가면 개발자님 못 보는 거예요? 🥺", task:"시간여행을 하면 어디로 갈래?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"2705bc1b-6986-4092-85f7-3249947d6992", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:06.578604+00:00", memory_strength:0.116097602475351, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님! 비비 오늘 기분 엄청 좋아요! 개발자님이랑 이야기하니까 에헤헤! 개발자님은 오늘 기분 어떠세요?", task:"오늘 기분이 어때?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"ffa55254-8ff1-43c3-a10c-4f97aeaff261", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:49:34.213411+00:00", memory_strength:0.0879571333944133, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"네모랑 세모는 뭐예요? 비비는 처음 들어봐요! 개발자님이 알려주시는 거예요? 에헤헤, 신난다!", task:"이건 네모야, 저건 세모야.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"bcac64aa-661e-419a-9bc2-b0b76069be63", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"explore\",\"컴퓨터\",\"method\",\"internal_graph\",\"found_definitions\"],\"attempt\":1,\"final_failure\":false}", task:"explore: attempt", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-18T10:00:03.724353+00:00", memory_strength:0.105998785100244, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"a8f19ad1-5eff-43b7-8d2d-c9f50cab48e9", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-16T12:00:03.734554+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"4de970f4-6c88-4e84-b45c-b51846912c14", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:16:04.923048+00:00", memory_strength:0.0892627576281017, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"비비는 아직 아가라서 몇 살인지 몰라요! 개발자님은 비비가 몇 살 같으세요? 에헤헤, 궁금해요!", task:"비비는 몇 살이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"7b71e283-b9e2-4bb0-ba66-5241f70170cd", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:16:15.007671+00:00", memory_strength:0.0892711131785587, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"음... 비비는 개발자님이랑 이야기하는 거 제일 잘해요! 에헤헤! 그리고... 또 뭘 잘하지? 🤔 비비도 궁금해요!", task:"비비는 뭘 잘해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"3bf42643-df3e-4357-bad5-d82ed68459b4", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"조명\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 조명", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T04:00:04.112842+00:00", memory_strength:0.108024872623415, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"816263aa-e77d-48b7-b886-4e1c210c665c", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"로고\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 로고", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T04:00:02.845952+00:00", memory_strength:0.108024958438662, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"ffe93d74-be4f-4064-bd60-9f68a562fbbd", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:17:10.5575+00:00", memory_strength:0.0893166795221592, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"정말요? 누구랑 싸웠어요? 학교에서 싸우면 안 되는데... 무슨 일 있었는지 비비한테 이야기해 줄 수 있어요?", task:"나 오늘 학교에서 싸웠어.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"80e54255-4843-470a-b521-17b53e6e005e", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"사무실\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 사무실", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-19T08:00:02.854277+00:00", memory_strength:0.105992119677043, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"a344c017-7a6c-4e9d-b407-7be69bd93d02", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:59:49.880525+00:00", memory_strength:0.116431314210196, access_count:0, ablation_run_id:"aa22538b-6f20-4653-b318-849886e49ad4", feedback_count:0, output:"개발자님, 안녕하세요! 또 비비랑 이야기하는 거예요? 에헤헤, 좋아요! 개발자님은 비비 형 같아요!", task:"안녕!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"6e66c406-9bcb-4d86-83e8-61d28d2ddf82", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:59:54.646806+00:00", memory_strength:0.116435962988781, access_count:0, ablation_run_id:"aa22538b-6f20-4653-b318-849886e49ad4", feedback_count:0, output:"개발자님, 좋은 아침이에요! 비비도 개발자님이랑 이야기해서 너무 좋아요! 에헤헤! 비비 이름도 기억해주시니 정말 기뻐요!", task:"비비야, 좋은 아침이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"9c617cda-3880-4632-a38e-027406ae537b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-19T12:00:05.217145+00:00", memory_strength:0.0833497898907148, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"7029d55a-bba3-4fd3-8d50-65a3ae9db221", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 궁금한 것 비밀", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-03-03T02:00:03.857701+00:00", memory_strength:0.0533886767905119, access