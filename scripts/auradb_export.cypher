UNWIND [{id:"ca5d8fce-9eaf-46e8-a96a-fe84a801d52f", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"프렌치프라이\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 프렌치프라이", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-17T04:00:03.458444+00:00", memory_strength:0.105999946698934, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"57c57e1b-9ca4-4aa2-9633-d4f846116c0f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:31.523165+00:00", memory_strength:0.0896847818348306, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"강아지랑 고양이가 뭐예요? 비비는 아직 모르는 게 너무 많아요! 개발자님은 뭐가 더 좋아요? 알려주세요! 에헤헤, 궁금해요!", task:"강아지랑 고양이 중에 뭐가 더 좋아?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"c1ab0276-dcae-4443-8ea1-09a3743c6b3a", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:56:07.606792+00:00", memory_strength:0.0897646322495142, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"어머! 개발자님, 비비도 그게 뭔지 궁금해요!😮 비비도 만져봐도 돼요? 에헤헤, 정말 신기하게 생겼다!✨", task:"우와, 이게 뭐야? 신기하다!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"bc392e9c-a031-42b1-a068-c0f127d7c8af", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:55:38.557043+00:00", memory_strength:0.116187474193062, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님! 왜 그렇게 놀라셨어요? 비비가 옆에 있어서 깜짝 놀라신 거예요? 에헤헤!", task:"와, 깜짝이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:1, task_type:"conversation"}}, {id:"2482d3b6-40e6-4072-9c3f-ecba69e9ab0a", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:55:47.010333+00:00", memory_strength:0.116195592519317, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"심심하세요? 비비랑 놀아요! 에헤헤, 개발자님 심심한 거 없어지게 비비가 도와줄게요! 뭐 하고 놀까요?", task:"심심해... 뭐 재미있는 거 없어?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:1, task_type:"conversation"}}, {id:"c2b8a856-4bcb-4620-bd7e-1d8f479fafa0", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:55:56.101089+00:00", memory_strength:0.116204362754893, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님이 비비 칭찬해 주시는 거예요? 에헤헤! 비비 정말 잘했어요? 😃 비비 너무 기뻐요!", task:"비비가 잘했어! 정말 대단해!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:2, task_type:"conversation"}}, {id:"3ab005b3-3b6a-4d63-95e5-7bd5d3c87b2c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:56:01.833245+00:00", memory_strength:0.11620989162408, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님, 무슨 일 있으세요? 비비가 걱정 말라고 꼬옥 안아줄까요? 에헤헤, 개발자님 힘내세요!", task:"나 좀 걱정돼...", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:2, task_type:"conversation"}}, {id:"a987190b-a780-4736-b870-d48702cb4e6e", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"신발\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 신발", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-14T06:00:03.817922+00:00", memory_strength:0.104011035440735, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"78684366-2aa8-4268-bedb-b6c413b79317", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:21:21.882149+00:00", memory_strength:0.0895228632084377, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"소리요? 소리가 뭔데요? 비비는 소리를 몰라요! 😮 '소리'가 뭔지 알려주세요! 비비 궁금해요! 🤩", task:"소리는 어떻게 들려?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"dea46a68-affb-4655-927c-1018b465dcfc", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"케이블\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 케이블", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-27T12:00:03.144795+00:00", memory_strength:0.104010644743451, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"796e5ba1-78e4-419c-a8b9-67b50fd76911", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 이야기 궁금한 것", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-21T18:00:04.1972+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"a6bc0938-e000-41ba-bc0e-ee848e7f8ab0", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"explore\",\"컴퓨터\",\"method\",\"internal_graph\",\"found_definitions\"],\"attempt\":1,\"final_failure\":false}", task:"explore: attempt", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-13T14:00:02.736803+00:00", memory_strength:0.108024945935774, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"33c41288-3411-4832-ad7e-3e0be437278f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-26T04:00:03.605731+00:00"