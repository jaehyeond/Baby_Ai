:begin
CREATE RANGE INDEX FOR (n:Concept) ON (n.category);
CREATE RANGE INDEX FOR (n:Concept) ON (n.strength);
CREATE RANGE INDEX FOR (n:EmotionLog) ON (n.created_at);
CREATE RANGE INDEX FOR (n:Experience) ON (n.created_at);
CREATE RANGE INDEX FOR (n:Experience) ON (n.development_stage);
CREATE RANGE INDEX FOR (n:Experience) ON (n.hour_of_day);
CREATE RANGE INDEX FOR (n:Experience) ON (n.speaker_id);
CREATE RANGE INDEX FOR (n:PendingQuestion) ON (n.status);
CREATE RANGE INDEX FOR (n:TemporalPattern) ON (n.time_slot);
CREATE VECTOR INDEX FOR (n:Concept) ON (n.embedding);
CREATE VECTOR INDEX FOR (n:Experience) ON (n.embedding);
CREATE VECTOR INDEX FOR (n:VisualExperience) ON (n.embedding);
CREATE CONSTRAINT autonomous_goal_id FOR (node:AutonomousGoal) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT baby_state_id FOR (node:BabyState) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT brain_region_name FOR (node:BrainRegion) REQUIRE (node.name) IS UNIQUE;
CREATE CONSTRAINT concept_id FOR (node:Concept) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT curiosity_log_id FOR (node:CuriosityLog) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT emotion_log_id FOR (node:EmotionLog) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT experience_id FOR (node:Experience) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT imagination_id FOR (node:Imagination) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT pending_q_id FOR (node:PendingQuestion) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT prediction_id FOR (node:Prediction) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT procedure_id FOR (node:Procedure) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT user_model_sid FOR (node:UserModel) REQUIRE (node.speaker_id) IS UNIQUE;
CREATE CONSTRAINT visual_exp_id FOR (node:VisualExperience) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
