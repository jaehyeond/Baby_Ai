6195, -0.028245868, 0.049902033, -0.013673636, 0.010169111, -0.0034333856, -0.026598442, -0.0051706713, 0.017717319, -0.04585835, -0.0491532, -0.03444618, 0.035135105, -0.004770047, -0.026239004, 0.0089260535, 0.011262404, 0.01669891, 0.010423713, 0.021416537, 6.814353E-4, 0.02003869, -0.005058347, -0.016024962, -0.03387707, -0.004770047, -0.0036804995, 0.02026334, 0.025909519, -0.024336975, -0.0010661468, -0.010498596, -0.015126366, 0.026658349, -6.795632E-4, -0.028680189, -0.0027182528, -0.0086639635, 0.02616412, 0.01034883, 0.0061029647, 0.011337287, 0.019529486, -0.026418723, 0.031301096], category:"frozen_knowledge"}}, {id:"734a3568-d5a5-4b3d-98e4-b8bfef855cda", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:53, strength:0.982819827004504, updated_at:"2026-02-06T09:30:10.027823+00:00", name:"삼성", created_at:"2026-02-03T08:36:10.465139+00:00", description:"대한민국의 대기업", category:"기업"}}, {id:"d6d09ee2-c8a4-4f8d-8171-2c52e848fdf1", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:0, usage_count:1, strength:0.7, updated_at:"2026-02-05T03:40:05.867054+00:00", name:"user_answer_experience_1770262805670", created_at:"2026-02-05T03:40:05.867054+00:00", description:"내가 생각하는 experience는 이제 과거 경험, 추억이라고 여전히 생각해. 그때의 경험 등으로 앞으로의 나의 행동에도 이제 영향을 줄 수 있어. 예를 들어서 내가 예전 경험으로 이렇게 하면 실패한다라는걸 알게 됐으면, 다음에 내가 할때는 실패했던 경험을 참고 삼아서 다른 방향으로 하거나 더 나은 방향으로 할 수 있게 도전 혹은 노력해볼 것 같아.", category:"user_experience"}}, {id:"cf2e86e8-782f-4738-ae36-b6954f5b8d70", properties:{exploration_count:7, definition_strength:0.32, acquired_at_stage:4, usage_count:2, last_explored_at:"2026-02-14T08:00:03.601+00:00", strength:0.605855402843319, updated_at:"2026-02-17T14:00:04.210898+00:00", name:"의자", created_at:"2026-02-07T03:35:13.695203+00:00", description:"시각적으로 관찰한 사물: 의자", category:"사물"}}, {id:"a418cd73-25e1-493a-b15b-120058001014", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:0, usage_count:1, strength:0.7, updated_at:"2026-02-04T04:56:20.429283+00:00", name:"user_answer_experience_1770180979422", created_at:"2026-02-04T04:56:20.429283+00:00", description:"경험이란 이제 지금 사실 너가 하는 모든 대화와 시각, 그리고 듣기까지 모든걸 다 경험이라고 볼 수 있어. 너가 인터넷으로 검색하는 것 까지 말이야. 이거에 대해서 너가 experience가 궁금하면 인터넷으로 검색해서 보다 정확하고 디테일하게 찾아봐. 사전적 정의도 확인하고 말이야.", category:"user_experience"}}, {id:"b988133f-06b7-4873-a4e7-b912e8cb394c", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:53, strength:0.982808796756707, updated_at:"2026-02-06T11:30:03.251751+00:00", name:"코", created_at:"2026-02-03T10:31:03.532141+00:00", description:"냄새를 맡는 감각 기관", category:"신체기관"}}, {id:"bc1fd570-1bf0-4c34-ba35-af8e12c86eca", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.555198093356293, updated_at:"2026-02-22T12:00:10.825589+00:00", name:"구경", created_at:"2026-02-19T07:31:19.567781+00:00", description:"눈으로 즐겁게 보는 행위", category:"활동", ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd"}}] AS row
CREATE (n:Concept{id: row.id}) SET n += row.properties;
