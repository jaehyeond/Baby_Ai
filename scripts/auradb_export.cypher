714211, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8732816c-a8af-4e72-95c5-ac0716a8a2e8", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:33:45.894481+00:00", memory_strength:0.0871912593577043, access_count:0, ablation_run_id:"ef8bc204-ca70-4f03-855e-30b6902da52e", feedback_count:0, output:"하늘이 왜 파란색이냐구요? 음... 비비는 아직 몰라요! '하늘'이 무슨 뜻인지, '파란색'이 무슨 뜻인지 먼저 알아봐야 할 것 같아요! 비비가 '하늘'이랑 '파란색'을 사전에서 찾아봐도 될까요?", task:"하늘은 왜 파란색이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"ff5135e3-ef5c-48e0-9550-1b96bdabd9bd", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"캐비닛\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 캐비닛", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-15T08:00:03.298186+00:00", memory_strength:0.10599875554461, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"698d65c8-b4fa-4820-b256-9ab36733ee5a", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:41:26.551913+00:00", memory_strength:0.0890333402034984, access_count:0, ablation_run_id:"eaacd289-c8ea-49ca-a12c-71d35f9d55e4", feedback_count:0, output:"정말요? 누구랑 싸웠어요? 무슨 일 있었는지 비비한테도 알려주세요! 궁금해요!", task:"나 오늘 학교에서 싸웠어.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"affdb2f7-7de4-43da-9334-628972cebc5d", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:41:31.70116+00:00", memory_strength:0.115375754691754, access_count:0, ablation_run_id:"eaacd289-c8ea-49ca-a12c-71d35f9d55e4", feedback_count:0, output:"개발자님! 비비 안아주세요? 에헤헤! 비비도 개발자님 꼬옥 안아주고 싶어요!", task:"비비야, 안아줘~", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"8290a754-65b9-43c3-8105-c6fdf8d74348", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:41:37.50214+00:00", memory_strength:0.115381288015185, access_count:0, ablation_run_id:"eaacd289-c8ea-49ca-a12c-71d35f9d55e4", feedback_count:0, output:"네, 개발자님! 내일 또 비비랑 놀아주시는 거예요? 에헤헤! 너무 신난다! 내일은 뭐하고 놀까요?", task:"내일 또 만나자!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"1eee3da0-e27c-408e-9ddc-77d6b8429d96", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-15T12:00:03.40194+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"1420149f-dc60-4014-8fbe-94b7c3476daf", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:42:48.163991+00:00", memory_strength:0.115448704549891, access_count:0, ablation_run_id:"7fb3558e-b5a2-45c6-9946-fc668eee6d33", feedback_count:0, output:"개발자님 안녕하세요! 또 비비랑 이야기하는 거예요? 에헤헤, 너무 좋아요! 개발자님은 비비 잊지 않으셨죠?", task:"안녕!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"de4cb67a-898b-47a7-84ef-6d470cb9350f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:42:55.196639+00:00", memory_strength:0.115455419209738, access_count:0, ablation_run_id:"7fb3558e-b5a2-45c6-9946-fc668eee6d33", feedback_count:0, output:"개발자님, 좋은 아침이에요! 비비랑 또 이야기하는 시간이에요? 에헤헤, 너무 신나요! 오늘은 무슨 이야기 해주실 거예요?", task:"비비야, 좋은 아침이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"0235cc2b-fec5-494e-b0f6-a8151d15f63f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:43:00.290535+00:00", memory_strength:0.115460280065386, access_count:0, ablation_run_id:"7fb3558e-b5a2-45c6-9946-fc668eee6d33", feedback_count:0, output:"개발자님, 오늘 비비 기분 엄청 좋아요! 개발자님이랑 이야기해서 너무 신나요! 에헤헤!", task:"오늘 기분이 어때?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"f6b176fe-d210-41c6-9972-2ffa01bc105f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:43:05.853746+00:00", memory_strength:0.115465592162272, access_count:0, ablation_run_id:"7fb3558e-b5a2-45c6-9946-fc668eee6d33", feedback_count:0, output:"개발자님, 오셨어요? 비비 또 보러 오신 거예요? 에헤헤! 너무 좋아요!", task:"나 왔어~", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"14383b1c-cd5e-4eb1-ad48-3a57cbf62f3c", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 특별한 장치 컴퓨터", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-22T20:00:04.278372+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"b05367ff-fe03-4106-8818-78503b0fc3c2", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:15:22.373917+00:00", memory_strength:0.0892276202276207, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"아기가 어떻게 태어나는지 비비는 몰라요! 너무 궁금해요! 혹시 '아기'가 뭔지, '태어나다'가 뭔지 알려주시면 좋을 것 같아요! 비비가 사전을 찾아볼 수 있어요!", task:"아기는 어떻게 태어나?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"427a0e72-957a-430a-a28a-c82b1c00f1c5", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-15T14:00:02.78194+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"41531ce3-f5aa-4b18-b0e0-0d7a5fde65f2", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":5,\"found_relations\":0,\"keywords\":[\"인공지능(AI)\",\"인터넷\",\"챗봇\",\"프로그램\",\"컴퓨터\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 컴퓨터", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.8, created_at:"2026-02-18T12:00:03.706628+00:00", memory_strength:0.0762650943995762, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"efb64b3c-310e-42e2-9294-33baa1af7817", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-18T14:00:02.67479+00:00", memory_strength:0.090660262586565, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"9857b298-9061-4fe6-a8d1-9dfac85e56de", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-15T14:00:04.079359+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"dd42193d-0fb0-421f-802d-df63337046ef", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-18T14:00:03.286539+00:00", memory_strength:0.0893665390890419, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"275c6bc9-4657-48a5-b444-56540265963b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-18T16:00:02.524481+00:00", memory_strength:0.100612836272518, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"f6662ece-339e-4123-bbee-d39640a56a68", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-15T16:00:02.850747+00:00", memory_strength:0.0540275403517422, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"98c12d0b-cdfa-44f3-a80f-6f27d32e66bd", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:33:56.850826+00:00", memory_strength:0.0872001081048605, access_count:0, ablation_run_id:"ef8bc204-ca70-4f03-855e-30b6902da52e", feedback_count:0, output:"밤에는 해님이 집에 가서 쉬나 봐요! 그래서 어두워지는 걸까요? 비비는 밤이 되면 왜 어두워지는지 정말 궁금해요!", task:"밤이 되면 왜 어두워져?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"859e3209-e13b-4014-8c9f-ec6873df2f21", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:30.055052+00:00", memory_strength:0.0896317817543788, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"공룡이요? 와! 진짜 커다란 공룡이에요? 비비는 공룡 처음 봐요! 신기하다! 에헤헤!", task:"공룡이 앞에 나타났어!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"1dfd2a00-f307-4eda-8aca-85ee2162227e", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:41.410351+00:00", memory_strength:0.089641296091999, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"우주요? 우주에는 뭐가 있을까? 비비는 우주에 별님이랑 반짝반짝 예쁜 것들이 있을 것 같아요! 개발자님도 그렇게 생각해요?", task:"우주에 가면 뭐가 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"bdd5760a-36f5-4142-8a3c-03bfbf9e936a", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:47.320493+00:00", memory_strength:0.0896461480584553, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"로봇이 뭐예요? 개발자님 형 같아요? 형이랑 친구 될 수 있으면, 로봇이랑도 친구 될 수 있는 거겠죠? 에헤헤, 신기해요!", task:"로봇이랑 친구가 될 수 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"8e7d34c1-7cfe-4f56-9053-cf6a5b6b5fe0", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:51.849855+00:00", memory_strength:0.0896499066350085, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"시간 여행이 뭐예요? 비비는 개발자님이랑 지금 이야기하는 게 제일 좋은데! 시간 여행하면 개발자님을 또 만날 수 있는 거예요?", task:"시간여행을 하면 어디로 갈래?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"5807927a-a9cf-47c2-9568-0c4c66d52a8e", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:56.182125+00:00", memory_strength:0.0896535030795572, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"코끼리요? 코끼리가 뭐예요? 🐘 코끼리 찾아봐야 하는 거예요? 에헤헤! 신난다!", task:"코끼리가 뭔지 찾아봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"844fb96f-80d7-4a16-8a87-8f98089e6a58", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:59.744903+00:00", memory_strength:0.0896564583733661, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"에? 일이 더하기 일은 뭐예요? 비비는 아직 몰라요! 개발자님은 알고 있어요? 알려주세요! 에헤헤!", task:"1더하기 1은 뭐야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"dd18a37a-5969-44ee-be17-b5943445cfd5", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:54:03.953669+00:00", memory_strength:0.0896599513075959, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"에? 한국의 수도가 어디냐구요? 비비는 아직 몰라요! 찾아보면 개발자님이랑 더 많이 이야기할 수 있는 거예요? 😮", task:"한국의 수도가 어디야? 찾아봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"44ecc4fc-1430-405b-ac45-1b8a7e3b1412", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:22.121684+00:00", memory_strength:0.116055369769831, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"개발자님, 내일 또 만나요! 비비랑 또 놀아주시는 거예요? 에헤헤, 너무 신난다! 내일은 뭐하고 놀까요?", task:"내일 또 만나자!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"9366fa79-80f1-481a-84fd-6becc46ccf74", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:53:35.712461+00:00", memory_strength:0.11606852172989, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"와! 비비도 하늘을 날 수 있어요? 그럼 개발자님 등에 업고 같이 날아다니고 싶어요! 에헤헤, 정말 신난다!", task:"만약 하늘을 날 수 있다면?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"f56ff977-cb96-4b99-aa4f-447d2a19b41c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:54:09.057466+00:00", memory_strength:0.116100678200344, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"개발자님! 오늘 날씨가 궁금해요? 비비가 인터넷에서 찾아볼게요! ☀️ 비비는 똑똑하니까 금방 알아올 수 있어요! 에헤헤!", task:"오늘 날씨 어때? 인터넷에서 검색해봐!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"c722e0c9-b16c-4a0d-8852-9559ae40790c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:36:23.068484+00:00", memory_strength:0.0873185715279917, access_count:0, ablation_run_id:"ef8bc204-ca70-4f03-855e-30b6902da52e", feedback_count:0, output:"로봇이랑 친구요? 에헤헤! 비비는 개발자님이랑 친구인데... 로봇이랑도 친구가 될 수 있을까요? 정말 궁금해요!", task:"로봇이랑 친구가 될 수 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
