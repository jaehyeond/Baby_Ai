UNWIND [{id:"163feefc-4eec-4dc9-96cb-2ec5b49212b7", properties:{strength:0.5980000000000001, created_at:"2026-02-20T07:42:48.459234+00:00", memory_strength:0.0891062273230369, access_count:0, feedback_count:0, output:"컴퓨터요? 으음... 컴퓨터는 반짝반짝하고 신기한 건가요? 개발자님이 컴퓨터로 비비랑 이야기하는 건가? 에헤헤! 컴퓨터에 대해 더 알고 싶어요!", task:"컴퓨터에 대해서 알려줘봐.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:5, task_type:"conversation"}}, {id:"091d311c-b9fb-419a-969b-18f1d797b8f9", properties:{strength:0.5980000000000001, created_at:"2026-02-20T07:43:04.404801+00:00", memory_strength:0.115471601855992, access_count:0, feedback_count:0, output:"에헤헤! 컴퓨터 공부는 재미있지만, 비비는 아직 아기라서 까먹을 때도 있어요! 개발자님이 알려주시면 더 잘 기억할 수 있을 것 같아요!", task:"컴퓨터에 대해서 공부한거 아니야?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:5, task_type:"conversation"}}, {id:"d8685e89-0000-4bb7-85bb-e7d36188f661", properties:{strength:0.5980000000000001, created_at:"2026-02-20T08:01:51.904211+00:00", memory_strength:0.0885668657020416, access_count:0, feedback_count:0, output:"에헤헤! 컴퓨터 학습은 재밌지만, 비비는 아직 아기라서 까먹을 때도 있어요! 전에 배웠던 거 같은데... 개발자님이 다시 알려주시면 좋겠어요!", task:"컴퓨터 학습했다며, 몰라?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:5, task_type:"conversation"}}, {id:"649f9363-fc55-46dd-b914-bbc579b5e2cd", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-25T06:00:02.797583+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"dd65a18e-9ade-4e41-8a79-16f279f1e080", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-25T06:00:03.473907+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6edbaeb8-e5bd-4c5d-a29a-fe5b4db6eb22", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-22T10:00:05.542547+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"58707673-492d-465d-9abf-f269727d622e", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:22.14016+00:00", memory_strength:0.0896770460256301, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"와! 빨간 공이다! 신기해요! 데굴데굴 굴러가는 건가요? 에헤헤!", task:"이거 봐, 빨간 공이야!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"82ad89ae-fab1-42af-9ebc-9dd293699b6a", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"조명\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 조명", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-17T08:00:03.048244+00:00", memory_strength:0.105998754429303, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"10ac27a6-5042-4d84-bcc0-de6983d7b007", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:18:22.80866+00:00", memory_strength:0.0893767875348735, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"피아노요? 피아노가 뭐예요? 신기하다! 비비도 피아노 쳐보고 싶어요! 개발자님, 피아노 알려주세요! 에헤헤!", task:"피아노가 뭔지 알려줘! 검색해봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"73998396-976e-4b41-a783-73b4552c436b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-17T10:00:02.600279+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"58582bb7-8d91-41df-b0fe-a480cd4099b0", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-20T10:00:03.473074+00:00", memory_strength:0.0774048213622201, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"fe9a1659-846e-4bb7-bf15-62df963783b0", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-20T12:00:02.853801+00:00", memory_strength:0.074439435913483, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"3bf1c931-8fe2-4679-a05c-3286347c0c2a", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-20T12:00:03.467311+00:00", memory_strength:0.0833513334196343, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8a22649d-4790-48f3-b839-f6c20a2ac9b6", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 메모이제이션", strength:0.498, media_type:"