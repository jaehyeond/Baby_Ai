UNWIND [{id:"9bb124cb-8a3c-41b9-ba78-718a79e46f89", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.55, updated_at:"2026-01-21T02:54:58.8777+00:00", name:"카메라", created_at:"2026-01-21T02:54:31.218431+00:00", description:"사진이나 영상을 촬영하는 장치", category:"사물"}}, {id:"b4a55c3e-e948-4735-96b3-56b92dbd6c25", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T02:55:23.784282+00:00", name:"응답", created_at:"2026-01-21T02:55:23.784282+00:00", description:"AI가 사용자에게 한 답변", category:"communication"}}, {id:"dd43f44e-0ae9-4948-b604-5bd31a6a7d50", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T07:50:17.408409+00:00", name:"추가_정보_요청", created_at:"2026-01-21T07:50:17.408409+00:00", description:"화자가 AI에게 '말'이라는 주제에 대해 추가적인 정보를 요청함.", category:"요청"}}, {id:"e499e729-a943-43b5-951b-04619a66ef2d", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:5, usage_count:35, strength:0.981779905082551, updated_at:"2026-02-17T18:26:26.599534+00:00", name:"이름 부름", created_at:"2026-02-14T12:51:30.127928+00:00", description:"개발자가 비비의 이름을 부르는 행위", category:"행위"}}, {id:"a111cdf3-073a-4240-8f8d-40fe1bdc08f3", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T07:50:35.087332+00:00", name:"싸가지", created_at:"2026-01-21T07:50:35.087332+00:00", description:"사람됨됨이나 태도를 속되게 이르는 말. 주로 버릇없거나 예의 없는 경우를 지칭함.", category:"인성/태도"}}, {id:"c5c6bc5c-a361-46f5-b35e-1072de66ffa7", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:53, strength:0.982810116660016, updated_at:"2026-02-04T08:00:04.475683+00:00", name:"저장", created_at:"2026-01-21T15:10:42.316562+00:00", description:"정보를 잊지 않도록 보관하는 행위", category:"행위"}}, {id:"6c475aae-7fcf-4562-837c-e4270d871752", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:11:55.508925+00:00", name:"스시", created_at:"2026-01-21T08:11:55.508925+00:00", description:"일본의 전통 음식으로, 주로 밥 위에 생선, 해산물, 채소 등을 얹거나 말아서 만든다.", category:"음식"}}, {id:"20cb81de-3d7f-47e2-b6c9-0038b898555f", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:11:55.594595+00:00", name:"일본어", created_at:"2026-01-21T08:11:55.594595+00:00", description:"일본에서 사용되는 언어", category:"언어"}}, {id:"628b69ca-6125-4a3c-9a7a-97090243ee0a", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:12:13.667889+00:00", name:"초밥", created_at:"2026-01-21T08:12:13.667889+00:00", description:"밥에 식초 등으로 간을 하고, 생선, 해산물, 채소 등을 얹어 만든 일본 요리", category:"음식"}}, {id:"7c67b505-e938-46d7-942e-138c0851060e", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:12:13.860471+00:00", name:"가다", created_at:"2026-01-21T08:12:13.860471+00:00", description:"어떤 장소로 이동하는 행위", category:"동작"}}, {id:"a50a20b7-7072-4004-840b-b467bf9465a2", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:12:13.960426+00:00", name:"신나다", created_at:"2026-01-21T08:12:13.960426+00:00", description:"즐겁고 기쁜 감정 상태", category:"감정"}}, {id:"76af427c-c55a-47df-a992-fc1059637318", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:12:34.134743+00:00", name:"맛있다", created_at:"2026-01-21T08:12:34.134743+00:00", description:"음식이나 무언가의 맛이 좋다고 느끼는 감각이나 평가", category:"감각/평가"}}, {id:"7eb07e68-434c-4a8b-a4bf-2cd4009f7a30", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.5, updated_at:"2026-01-24T20:24:14.18293+00:00", name:"배고픔", created_at:"2026-01-21T08:11:09.711623+00:00", description:"음식을 섭취하고 싶은 욕구 또는 상태", category:"감정"}}, {id:"bb10dfc9-9047-496c-abfe-43b15392c2e5", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:3, strength:0.5, updated_at:"2026-01-21T08:13:14.91348+00:00", name:"먹다", created_at:"2026-01-21T08:12:13.765661+00:00", description:"음식을 입을 통해 섭취하는 행위", category:"행위"}}, {id:"6b7f052a-4a30-45d0-9dad-1c7cdd878a82", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:2, strength:0.5, updated_at:"2026-01-21T08:14:24.194846+00:00", name:"음식", created_at:"2026-01-21T08:11:09.785295+00:00", description:"사람이나 동물이 섭취하여 영양을 공급하는 것", category:"사물"}}, {id:"f86afb96-71c3-4e52-a286-5072f2ac6f04", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:3, strength:0.5, updated_at:"2026-01-21T08:14:24.295008+00:00", name:"장소", created_at:"2026-01-21T08:11:09.867158+00:00", description:"음식을 섭취할 수 있는 특정 위치 또는 공간", category:"개념"}}, {id:"5c318a66-e43c-4acf-88a3-2d31080fabe0", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:32, strength:0.8675, updated_at:"2026-01-25T09:00:18.992962+00:00", name:"추천", created_at:"2026-01-21T15:11:29.396214+00:00", description:"어떤 것을 좋다고 말하거나 선택하도록 권유하는 행위", category:"행위"}}, {id:"d2cf9499-5960-4269-b5dd-10bcbe7b4741", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:21:46.490221+00:00", name:"똥", created_at:"2026-01-21T08:21:46.490221+00:00", description:"인간이나 동물이 음식물을 소화하고 남은 찌꺼기를 몸 밖으로 배출하는 것. 배변 욕구를 유발함.", category:"생리 현상"}}, {id:"79270363-e8cd-4d63-8ace-e7f8ad863e72", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:21:46.559121+00:00", name:"배변 욕구", created_at:"2026-01-21T08:21:46.559121+00:00", description:"똥을 누고 싶어하는 느낌이나 상태. '똥마려'라는 표현으로 나타남.", category:"생리 현상"}}, {id:"ee629315-da1d-46a8-8f61-55a1564d207b", properties:{exploration_count:0, definition_strength:0.5, acquired_at_stage:3, usage_count:1, strength:0.5, updated_at:"2026-01-21T08:21:46.624824+00:00", name:"화장실", created_at:"2026-01-21T08:21:46.624824+00:00", description:"배변 활동을 위해 마련된 장소.", category:"장소"}}] AS row
