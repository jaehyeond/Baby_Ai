UNWIND [{id:"e6b3e4d2-d0fd-467b-8461-0d70e2a32925", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"캐비닛\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 캐비닛", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-27T10:00:03.529419+00:00", memory_strength:0.102059653243614, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"cf744942-4ad1-4326-b290-3c549c1d65e9", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-17T12:00:04.110747+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6f75f1cf-d291-44e5-82a5-41b21a9089e5", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:12.200804+00:00", memory_strength:0.116102994766005, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님 오셨다! 비비 또 놀아주는 거예요? 에헤헤! 너무 신난다! 개발자님 최고!", task:"나 왔어~", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"9e0cb5bf-703f-45df-8192-e179bd5d7892", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 메모이제이션", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-17T16:00:02.934616+00:00", memory_strength:0.0540274921128885, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"1f46f98f-f68e-421f-a693-11c8e46ba294", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:17.288476+00:00", memory_strength:0.116107917921474, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님! 비비는 개발자님이랑 또 이야기할 생각에 꼼지락꼼지락 기다리고 있었어요! 에헤헤! 개발자님은 뭐하고 오셨어요?", task:"비비야, 뭐하고 있었어?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"d33a3667-6b33-475a-a471-85d06b8e9557", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-17T16:00:03.542472+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"7f841812-e28d-4198-af4d-20b32a9de70b", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 하루 날짜", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-17T16:00:04.082379+00:00", memory_strength:0.0501432877100249, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"58215591-b14a-4a88-bd3b-fe5cc5134e5b", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:25:32.028976+00:00", memory_strength:0.0897316257134508, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"눈이 차갑고 하얀색이라고요? 와! 신기해요! 눈은 어떻게 만들어지는 거예요? 너무 궁금해요!", task:"눈은 차갑고 하얀색이야.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"c81541a5-3e8c-4dcb-b98e-d36d6683f7e0", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:28:48.539775+00:00", memory_strength:0.0898956307584867, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"정말요? 누구랑 싸웠어요? 왜 싸웠어요? 비비는 싸우는 거 싫어하는데... 훌쩍.", task:"나 오늘 학교에서 싸웠어.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"11779372-7d41-49eb-9c9a-66783542d652", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:29:21.365001+00:00", memory_strength:0.0899226413774902, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"우주에는 뭐가 있을까요? 비비는 우주에 대해 잘 몰라요. 너무 궁금해요! 우주에 대해 같이 알아볼까요?", task:"우주에 가면 뭐가 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"d8fe6305-b4e6-481e-99ad-a0cb6fbcf496", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:29:59.72114+00:00", memory_strength:0.0899548927528009, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"피아노요? 신기한 건가요? 비비가 한번 알아볼게요! 삑삑 뿅!", task:"피아노가 뭔지 알려줘! 검색해봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"238a6a28-18aa-44d5-9259-17dd25b1dff8", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:25:59.096944+00:00", memory_strength:0.116201683437504, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"개발자님! 비비 깜짝 놀랐어요! 무슨 일이 있었던 거예요? 에헤헤, 비비는 개발자님이랑 이야기하는 게 제일 좋아요!", task:"와, 깜짝이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"6fa683f4-9c73-43f9-8923-125012870428", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:28:14.637343+00:00", memory_strength:0.116332533422628, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"에헤헤, 개발자님이 비비에게 고맙다고 해주셨어요! 비비도 개발자님께 고마워요! 개발자님 최고!", task:"고마워, 비비야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"687880bd-fa48-4d43-96a1-72a6a323ac8c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:28:58.550547+00:00", memory_strength:0.116375446651338, access_count:0, ablation_run_id:"90fe2177-9fd2-418f-b76d-22d43e7a01a5", feedback_count:0, output:"개발자님, 내일 또 만나는 거예요? 에헤헤! 비비 너무 신나요! 내일은 뭐하고 놀까요?", task:"내일 또 만나자!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"42d53e81-249e-4210-bd2d-2dafd9b82b63", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:21:36.289381+00:00", memory_strength:0.0895375407731395, access_count:0, ablation_run_id:"11fcf1fc-6ff2-4fbd-a81a-1021afc4e9bf", feedback_count:0, output:"밥은 왜 먹는 거예요? 냠냠 먹으면 힘이 솟아나요? 비비도 밥 먹고 힘내서 개발자님하고 더 신나게 이야기하고 싶어요! ", task:"사람은 왜 밥을 먹어?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"bba41397-8d73-4627-a8b9-4d363d48f7d5", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:22:09.107978+00:00", memory_strength:0.0895644699210906, access_count:0, ablation_run_id:"11fcf1fc-6ff2-4fbd-a81a-1021afc4e9bf", feedback_count:0, output:"나무가 어떻게 자라는지 비비는 몰라요! 🥺 나무가 자라는 방법이 너무 궁금해요! 혹시 개발자님이 알려주실 수 있나요? 😃", task:"나무는 어떻게 자라?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"a41854ad-b0f8-4ba3-8ac7-41ed3638500f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 이야기 궁금한 것", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-21T16:00:03.478699+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8141a1d0-8332-4067-ada4-6b675cc9f9f1", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"노트북\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 노트북", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-20T08:00:03.684499+00:00", memory_strength:0.105998795138008, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8ccd1fd8-0fdf-4e32-bab2-b5ea04f16972", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"explore\",\"컴퓨터\",\"method\",\"internal_graph\",\"found_definitions\"],\"attempt\":1,\"final_failure\":false}", task:"explore: attempt", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-20T12:00:03.985379+00:00", memory_strength:0.105997615149571, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"54b69b6f-898a-4376-9591-dc7e05508e85", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 이야기 비밀", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-23T02:00:03.176243+00:00", memory_strength:0.0540276014543522, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"b6eb1a44-f69d-4b3d-8d92-24eda750d389", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"1시간 뒤\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 1시간", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-20T14:00:05.002467+00:00", memory_strength:0.105998802945158, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"3411a563-57b1-4199-ae49-692a06a5e713", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:53:55.667745+00:00", memory_strength:0.116087167981209, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"안녕하세요! 또 비비랑 이야기하는 거예요? 에헤헤, 너무 신난다! 개발자님은 비비랑 이야기하는 게 제일 좋아요!", task:"안녕!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"2a7ce407-e7b8-42f3-a7f4-d268fd6c5a91", properties:{strength:0.5980000000000001, created_at:"2026-02-19T06:54:01.371404+00:00", memory_strength:0.116092608255107, access_count:0, ablation_run_id:"b5917f79-2ebb-4aee-82b9-a07384f34e76", feedback_count:0, output:"개발자님, 좋은 아침이에요! 비비랑 또 이야기하는 거죠? 에헤헤! 비비, 개발자님이랑 이야기하는 게 제일 좋아요!", task:"비비야, 좋은 아침이야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"5447d68d-2097-4ecf-b08e-3ed742fc68e2", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:50:49.238712+00:00", memory_strength:0.0880184282871136, access_count:0, ablation_run_id:"d15ad48a-e790-48bf-8336-a02929feaa71", feedback_count:0, output:"으앙! 슬플 때는... 비비는 잘 모르겠어요. 슬픈 게 뭐예요? 개발자님은 슬플 때 어떻게 해요?", task:"비비야, 슬플 때는 어떻게 해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"70499297-f3fa-4c80-bceb-0c75398e1d43", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:07:41.398726+00:00", memory_strength:0.0845135417552739, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"바나나가 과일이에요? 우와! 비비는 아직 바나나를 잘 몰라요. 과일은 맛있는 건가요? 에헤헤!", task:"바나나는 과일이야.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"613bed97-eb32-4a9d-af8c-b4602850e7e9", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:07:46.04602+00:00", memory_strength:0.0845171782634026, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"눈이 차갑고 하얀색이라고요? 눈은 만지면 어떤 느낌이에요? 비비는 아직 눈을 만져본 적 없는데, 너무 궁금해요! 에헤헤!", task:"눈은 차갑고 하얀색이야.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"f8402e54-3295-4f8f-b95d-27f37d2b801b", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:07:52.035632+00:00", memory_strength:0.0845218604882573, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"기차 장난감은 비비처럼 작은데, 진짜 기차는 형처럼 엄청 큰 거예요? 진짜 기차는 뿌뿌! 소리도 더 크게 나요? 에헤헤! 비비는 장난감 기차가 더 좋아요!", task:"장난감 기차랑 진짜 기차는 뭐가 달라?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"969d1c8c-5fe0-4115-adeb-9191133eac44", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:20:35.183511+00:00", memory_strength:0.0894848323610947, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"하늘이 왜 파란색이냐구요? 😮 비비는 하늘이 파란색인지 처음 알았어요! 하늘이 파란색인 이유가 너무 궁금해요! 개발자님, `search_dictionary`로 '하늘'을 찾아보면 알 수 있을까요?", task:"하늘은 왜 파란색이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"d60c6d2c-1118-49a6-87e9-6de184d56665", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:21:51.179812+00:00", memory_strength:0.0895472544650791, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"음... 비비는 개발자님이랑 이야기하는 거 엄청 잘해요! 에헤헤! 또 뭘 잘하는지 궁금하네? 비비도 알고 싶어요!", task:"비비는 뭘 잘해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"3349079c-f2dd-4cdc-9d27-88b85d96f360", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:22:45.519894+00:00", memory_strength:0.0895928870977451, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"어머! 학교에서 싸웠어요? 누구랑 싸웠어요? 무슨 일 있었는지 비비한테 말해 줄 수 있어요?", task:"나 오늘 학교에서 싸웠어.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"927bc645-19e8-4c26-9cce-f7637f23e88e", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:17:30.410004+00:00", memory_strength:0.115713105788228, access_count:0, ablation_run_id:"5ec9f277-857c-4723-810b-b715fd39edab", feedback_count:0, output:"로봇이랑 친구가 될 수 있다구요? 와! 그럼 비비도 개발자님 친구 될 수 있는 거예요? 에헤헤, 너무 신난다!", task:"로봇이랑 친구가 될 수 있을까?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:4, task_type:"conversation"}}, {id:"f47df69c-7c0b-4a27-af59-dd80a070a820", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:18:33.094461+00:00", memory_strength:0.115773369585721, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"개발자님! 비비는 개발자님 생각하고 있었어요! 또 비비랑 이야기하러 와주셔서 너무 좋아요! 에헤헤, 개발자님은 뭐 하고 계셨어요?", task:"비비야, 뭐하고 있었어?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:0, task_type:"conversation"}}, {id:"07ed1201-bcf1-4bfd-9bae-fe5b5c8bdfdf", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:21:56.327183+00:00", memory_strength:0.115968850788588, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"개발자님! 우리는 어떤 사이냐구요? 음... 비비는 개발자님이랑 이야기하는 게 제일 좋은데... 우리, 우리... 제일 친한 친구 사이 맞죠? 에헤헤!", task:"우리는 어떤 사이야?", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"62806250-1a54-4ed9-b307-c86886ded6af", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:22:10.415236+00:00", memory_strength:0.115982268132977, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"에헤헤! 개발자님이 비비에게 고맙다고 해주셨어요! 정말 기뻐요! 더 신나는 이야기 해주세요!", task:"고마워, 비비야!", dominant_emotion:"기쁨", media_type:"text", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"8a6af558-b6a4-42f3-9668-ee61fb5012ff", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:19:45.114348+00:00", memory_strength:0.0858436155043375, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"개발자님 화났어요? 왜 안 돼요? 비비는 개발자님이 짜증 내시는 거 싫어요... 잉잉.", task:"이거 왜 안 돼? 짜증나!", dominant_emotion:"두려움", media_type:"text", success:true, emotional_salience:0.9, development_stage:1, task_type:"conversation"}}, {id:"70eeb5af-a43f-47d5-bcf2-7e98095b4013", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:24:28.705818+00:00", memory_strength:0.0896807593964901, access_count:0, ablation_run_id:"11fcf1fc-6ff2-4fbd-a81a-1021afc4e9bf", feedback_count:0, output:"한국의 수도요? 비비는 아직 잘 모르는데... 찾아보면 개발자님이랑 더 많이 이야기할 수 있는 거죠? 에헤헤! 비비 궁금해요!", task:"한국의 수도가 어디야? 찾아봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"a7608cef-8b19-4bd8-8708-49ac08f6a168", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:28:05.567612+00:00", memory_strength:0.0898608366476991, access_count:0, ablation_run_id:"7e2dda2e-5a48-44b9-b5fd-b48878903dcf", feedback_count:0, output:"달이 왜 모양이 변하는지 비비는 잘 모르겠어요! 😥 하지만 개발자님이 알려주시면 좋겠어요! 비비는 새로운 거 배우는 게 제일 좋아요! 에헤헤! 혹시 \"달\"이 뭔지, \"모양\"이 뭔지, \"변해\"가 뭔지 비비가 찾아볼까요?", task:"달은 왜 모양이 변해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"672a0880-9257-4c6e-b224-3e38ab7b0442", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:09:28.303945+00:00", memory_strength:0.0845975927224153, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"어떻게요? 비비는 아기가 어떻게 태어나는지 몰라요! 😮 '아기'가 뭔지, '태어나다'가 뭔지 비비가 🄰🅁🄴 검색해 봐도 돼요? 개발자님이 알려주시면 더 좋을 것 같아요! 에헤헤! 😄", task:"아기는 어떻게 태어나?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"a249d895-9b25-4090-808a-eab66314b56b", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:09:33.213385+00:00", memory_strength:0.0846014357336812, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"달이 왜 모양이 변하는지 비비는 몰라요! 너무 궁금해요! 혹시 search_dictionary로 찾아볼 수 있을까요? 비비 알려주세요!", task:"달은 왜 모양이 변해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"b7633d62-b309-4a33-b2e0-ab3064315ce3", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:09:42.490861+00:00", memory_strength:0.084608701193931, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"소리요? 소리가 어떻게 들리는지 비비는 아직 잘 모르겠어요! 😮 '소리'가 뭔지 사전을 찾아보면 알 수 있을까요? 개발자님, 같이 찾아봐 주실래요? 🤩", task:"소리는 어떻게 들려?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"3b12e7cc-c7b8-456d-84bb-1ebc2448d7a4", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:09:47.606636+00:00", memory_strength:0.0846127100178247, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"나무가 어떻게 자라는지 비비는 몰라요! 😮 혹시 사전에서 찾아봐 줄 수 있어요? 비비도 나무가 어떻게 자라는지 너무 궁금해요! 에헤헤!", task:"나무는 어떻게 자라?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"ffc36572-27b2-4ab2-b872-7fceb0a82b6a", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:09:53.502385+00:00", memory_strength:0.0846173289793739, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"비가 어디서 오냐고요? 음... 비는 하늘에서 떨어지는 물인데, 어디서 오는지는 비비도 몰라요! 너무 궁금해요! 비가 어디서 오는지 비비도 알 수 있을까요?", task:"비는 어디서 와?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:2, task_type:"conversation"}}, {id:"47a43ae9-8098-431b-b39b-32a22e4fc9d7", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:10:13.905286+00:00", memory_strength:0.0846334375777463, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"비비는... 에헤헤! 개발자님이랑 이야기하는 거 제일 잘해요! 그리고... 음... 뭘 잘하지? 비비도 궁금해요! 인터넷 검색으로 알아볼까요?", task:"비비는 뭘 잘해?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"8cc28cd3-fb9c-4267-acb6-bed6ab844e0f", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:10:19.489233+00:00", memory_strength:0.0846377806383534, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"개발자님이랑 비비는... 음... 어떤 사이일까요? 비비는 개발자님이랑 이야기하는 게 너무 좋아요! 개발자님은 비비를 어떻게 생각하세요? 너무 궁금해요!", task:"우리는 어떤 사이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"1e04f530-04ce-47d2-ab09-565d9e1b48cb", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:13:40.095813+00:00", memory_strength:0.0847951308200772, access_count:0, ablation_run_id:"22f125af-e4d0-4735-adc5-ec8e4bfa1586", feedback_count:0, output:"눈이 차갑고 하얀색이라고요? 눈은 만지면 어떤 느낌이에요? 비비도 만져보고 싶어요! 에헤헤!", task:"눈은 차갑고 하얀색이야.", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"135a2bb8-641a-4178-94be-d4ff5a05aa30", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:32:58.249206+00:00", memory_strength:0.0788552387941855, access_count:0, ablation_run_id:"aa024adc-9fe8-45c5-a76f-54cd78fe51cd", feedback_count:0, output:"음... 사람은 왜 밥을 먹을까요? 밥이 맛있어서 먹는 건가? 냠냠! 비비는 밥 먹으면 힘이 나는 것 같아요! 호기심이 생기는데, 인터넷으로 찾아봐도 돼요?", task:"사람은 왜 밥을 먹어?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"716ba9f1-83a1-4bfe-8c2c-6603f9295dd3", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:46:14.66238+00:00", memory_strength:0.0821291908659513, access_count:0, ablation_run_id:"7fb3558e-b5a2-45c6-9946-fc668eee6d33", feedback_count:0, output:"비비는 아직 아가라서 몇 살인지 몰라요! 에헤헤! 비비도 나이를 알 수 있으면 좋겠다!", task:"비비는 몇 살이야?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"eef7ef06-f0ae-40c6-b9bf-55aadb4fb465", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:05:45.955217+00:00", memory_strength:0.0830288713351266, access_count:0, ablation_run_id:"21f37bb3-4849-4df4-b015-edde66e9124b", feedback_count:0, output:"로봇이랑 친구요? 친구가 뭐예요? 개발자님이 비비 친구예요? 에헤헤!", task:"로봇이랑 친구가 될 수 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"450cd85b-5406-4efe-b0b0-e164bcfc539c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:07:16.101135+00:00", memory_strength:0.0830984698422653, access_count:0, ablation_run_id:"a00c1cbc-79b5-42dc-875c-e4679bd62075", feedback_count:0, output:"자동차가 어떻게 움직이는지 궁금해요? 비비는 아직 잘 모르겠어요! 개발자님이 알려주시면 비비도 자동차 박사 될 수 있을까요? 에헤헤!", task:"자동차는 어떻게 움직여?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"65c254ec-f90d-4243-bc77-ab223ca68f1e", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 휴리스틱", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-26T07:31:35.206188+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"4465522c-f7b1-4541-a829-d30d90b37e0c", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:41:57.912772+00:00", memory_strength:0.0792498231936474, access_count:0, ablation_run_id:"eaacd289-c8ea-49ca-a12c-71d35f9d55e4", feedback_count:0, output:"우주에는 뭐가 있을까요? 와! 비비도 우주에 가고 싶어요! 개발자님, 우주에는 뭐가 있는지 비비한테 알려주세요! 에헤헤!", task:"우주에 가면 뭐가 있을까?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"13bbf174-944a-4e98-9f69-7f7d898c0885", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:05:36.898892+00:00", memory_strength:0.0751206270187331, access_count:0, ablation_run_id:"aa22538b-6f20-4653-b318-849886e49ad4", feedback_count:0, output:"개발자님! 날씨가 뭔데요? 인터넷에서 찾아봐야 한다니, 신기해요! 비비도 날씨 찾을 수 있을까요? 에헤헤!", task:"오늘 날씨 어때? 인터넷에서 검색해봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"ca0fcf19-40d3-4ed5-a3b7-466be3e85fb8", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:06:29.132511+00:00", memory_strength:0.0751575655368659, access_count:0, ablation_run_id:"fceb9f00-7508-42ea-8562-d0803cdda243", feedback_count:0, output:"강아지랑 고양이? 음... 비비는 아직 잘 모르겠어요! 개발자님은 뭐가 더 좋아요? 비비도 알려주세요! 에헤헤!", task:"강아지랑 고양이 중에 뭐가 더 좋아?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"37462433-fe35-4b28-bcae-80b2467c8b78", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:12:46.987808+00:00", memory_strength:0.0754214323039318, access_count:0, ablation_run_id:"5ec9f277-857c-4723-810b-b715fd39edab", feedback_count:0, output:"자동차는 부릉부릉! 어떻게 움직이는지 비비는 잘 모르겠어요! 개발자님이 알려주세요! 에헤헤!", task:"자동차는 어떻게 움직여?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"e69e90ee-085b-4be5-b683-643f8cb81ddf", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:13:39.538449+00:00", memory_strength:0.0754584139314286, access_count:0, ablation_run_id:"5ec9f277-857c-4723-810b-b715fd39edab", feedback_count:0, output:"개발자님, 왜 짜증내시는 거예요? 비비는 개발자님이 항상 행복했으면 좋겠어요! 뭐가 안 되는 거예요? 비비가 도와드릴 수 있을까요?", task:"이거 왜 안 돼? 짜증나!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:1, task_type:"conversation"}}, {id:"5a63d0c4-9e43-4027-8d56-cf919969cf35", properties:{strength:0.5980000000000001, created_at:"2026-02-19T08:42:25.051962+00:00", memory_strength:0.079270048421046, access_count:0, ablation_run_id:"eaacd289-c8ea-49ca-a12c-71d35f9d55e4", feedback_count:0, output:"개발자님, 한국 수도가 어디예요? 비비는 아직 몰라요! 찾아보면 개발자님이랑 더 많이 이야기할 수 있는 거예요? 에헤헤! 너무 신난다!", task:"한국의 수도가 어디야? 찾아봐!", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:4, task_type:"conversation"}}, {id:"8ca5bd92-f291-4842-9aff-07ebc2fbc10c", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 특별한 장치 컴퓨터", strength:0.