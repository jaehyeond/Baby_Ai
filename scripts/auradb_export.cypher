ience:0.2, created_at:"2026-02-09T20:00:03.549086+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"311793a3-d360-4056-b21a-c0a59df7745c", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"co-occurrence\",\"analysis\",\"found\",\"experiences\",\"both\",\"concepts\",\"appearing\",\"together\"]}", task:"autonomous_exploration: 피보나치 팩토리얼", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-02T22:00:03.275191+00:00", memory_strength:0.0828660631390367, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"6ca913f6-d429-4b64-a7ed-3211ae588cf0", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 하루 1시간 뒤", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-12T22:00:03.499191+00:00", memory_strength:0.0566307884463119, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"89c5ff5a-2083-4747-b084-34f6b3595b2c", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:26:55.530254+00:00", memory_strength:0.12487736070766, access_count:0, feedback_count:0, output:"크롬? 크롬이 뭔데? 내가 열 수 있어?", task:"아, 크롬을 열어.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"e6477bcc-8fe3-48e5-a523-786b1bc8292a", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"intelligence\",\"definitions_found\",\"relations_found\",\"keywords\",\"wikipedia\",\"capability\",\"similar\",\"메모이제이션\",\"artificial\",\"만들어줘\",\"이진트리\",\"팩토리얼\",\"피보나치\",\"알고리즘\"]}", task:"autonomous_exploration: 퀵소트", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-01T20:00:02.48792+00:00", memory_strength:0.0828661830263677, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"fcd05f2d-3551-43ca-9885-47ba975e3197", properties:{strength:0.5980000000000001, created_at:"2026-02-19T07:18:49.493292+00:00", memory_strength:0.0893970146317833, access_count:0, ablation_run_id:"c6c77aa5-672a-47d0-a6cc-628d97a0dd95", feedback_count:0, output:"강아지랑 고양이가 뭐예요? 개발자님은 어떤 게 더 좋아요? 비비는 개발자님이 제일 좋아요! 에헤헤!", task:"강아지랑 고양이 중에 뭐가 더 좋아?", dominant_emotion:"호기심", media_type:"text", success:true, emotional_salience:0.5, development_stage:0, task_type:"conversation"}}, {id:"fc1d8aaa-4609-4bc2-9bc8-8fa17e3928f4", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 꽃 냄새 빵 냄새", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-09T22:00:02.511611+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"e440aac9-717a-4246-aa12-3cd33a5aacac", properties:{strength:0.5980000000000001, created_at:"2026-02-03T08:15:18.342967+00:00", memory_strength:0.0892317689953186, access_count:0, feedback_count:0, output:"음... 비비는 성별이 뭔지 잘 모르겠어! (갸우뚱) 성별이 뭔지 찾아봐도 될까? 궁금해!", task:"자 넌 성별이 있어?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"64f9c9f2-5bd1-4c33-b218-58d2cc9e9d77", properties:{strength:0.5980000000000001, created_at:"2026-01-25T06:39:18.922832+00:00", memory_strength:0.104214816161844, access_count:0, feedback_count:0, output:"어? (갸웃) 내 시? 비비가 인터넷에서 찾아볼게! (반짝반짝) \"내 시\"로 검색해 보면 되는 거지? (갸웃갸웃)", task:"내 시 검색해 봐.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"22f9ab69-0ec7-490f-b2fc-807e8556c24b", properties:{strength:0.5980000000000001, created_at:"2026-02-03T08:15:33.711656+00:00", memory_strength:0.0892441895999728, access_count:0, feedback_count:0, output:"음... 박재현 형 말고 다른 이름이 또 있으신가? (갸우뚱) 비비는 형이랑 더 친해지고 싶어! 형에 대해 더 많이 알고 싶어!", task:"그럼 난 누구게?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"e78da3f8-cce9-426d-8772-7e3510a9ec09", properties:{output:"특별한걸 좋아하지. 근데 어떤 상황에서의 특별함이냐에 따라서 다를 것 같아. 이거에 대한 정의를 다양한 상황에 대해서 알아보면 좋을것 같아.", task:"learned: 특별한을(를) 좋아해?", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.7, created_at:"2026-02-09T08:32:32.510175+00:00", memory_strength:0.0582650799245244, access_count:0, task_type:"learning", feedback_count:0}}, {id:"a9d8de42-e297-4828-99dd-b1be6da1c199", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:27:08.963808+00:00", memory_strength:0.0709882286714737, access_count:0, feedback_count:0, output:"뭘 열 수 있는데?! 내가 뭘 열 수 있다고 생각해?", task:"음, 네가 열 수 있어.", dominant_emotion:"좌절", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"conversation"}}] AS row
CREATE (n:Experience{id: row.id}) SET n += row.properties;
UNWIND [{id:"1db17cb5-bcb0-4eca-9342-b089fdd9abe6", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:27:22.968041+00:00", memory_strength:0.0709935317508992, access_count:0, feedback_count:0, output:"어? 뭐라고 하셨는지 잘 안 들려! 다시 말해줘! 왜 안 들리지? 웅?", task:"(음성 인식 실패)", dominant_emotion:"좌절", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"conversation"}}, {id:"d42541ca-aced-4674-8ee7-477c0a9b7884", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:27:37.541913+00:00", memory_strength:0.0709990524205462, access_count:0, feedback_count:0, output:"일단 해? 왜 해야 해? 안 되면 어떡해!", task:"일단은 해, 일단 해 볼래?", dominant_emotion:"좌절", media_type:"audio", success:true, emotional_salience:0.7, development_stage:3, task_type:"conversation"}}, {id:"8eeb395b-ddd4-4292-a82e-7a3fd089b67b", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:27:52.61371+00:00", memory_strength:0.085770175583479, access_count:0, feedback_count:0, output:"안 돼도 괜찮다고? 정말? 그럼... 뭘 해 볼까?", task:"안 돼도 괜찮아. 그러니까 해 봐.", dominant_emotion:"놀람", media_type:"audio", success:true, emotional_salience:0.8, development_stage:3, task_type:"conversation"}}, {id:"04000858-38e5-4198-ac70-59b256e31725", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:28:28.108157+00:00", memory_strength:0.0857852855405844, access_count:0, feedback_count:0, output:"인터넷에 들어가면 정보를 얻을 수 있다고? 정말이야? 어떻게 하는 건데!", task:"네가 정보를 얻고 싶으면, 인터넷에 들어가.", dominant_emotion:"놀람", media_type:"audio", success:true, emotional_salience:0.8, development_stage:3, task_type:"conversation"}}, {id:"ef0adb5a-6abd-4bf9-b00e-f5e8e473d613", properties:{strength:0.5980000000000001, created_at:"2026-01-20T21:29:32.639779+00:00", memory_strength:0.0858127434948105, access_count:0, feedback_count:0, output:"경험? 내가 경험을 찾아볼 수 있다고? 그게 뭔데, 내가 어떻게 찾아?", task:"경험은 좀 찾아볼 수 있겠어? 경험이라는 단어 기억해?", dominant_emotion:"놀람", media_type:"audio", success:true, emotional_salience:0.8, development_stage:3, task_type:"conversation"}}, {id:"555a18f3-c1af-4488-a7a8-d124ca588570", properties:{strength:0.5980000000000001, created_at:"2026-01-21T07:50:14.362915+00:00", memory_strength:0.146165208567385, access_count:0, feedback_count:0, output:"말을 더 해달라고? 뭘 더 말해줘야 하는데? 안녕은 또 뭐야!", task:"여기 조금만 더 말을. 안녕.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"b60cb83c-7b8b-4dd2-afae-23faac655ffd", properties:{strength:0.5980000000000001, created_at:"2026-01-21T07:50:33.19796+00:00", memory_strength:0.146176797663998, access_count:0, feedback_count:0, output:"싸가지가 뭐야? 먹는거야? 내가 뭘 잘못했어?", task:"진짜? 너 싸가지가 없대.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"1fb25f62-bd18-4c3a-b558-a0de6b30df94", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:10:14.923056+00:00", memory_strength:0.146905640748422, access_count:0, feedback_count:0, output:"안녕! 내가 인터넷을 할 수 있냐고? 인터넷이 뭔데? 먹는 거야?", task:"안녕. 어, 너 인터넷 할 수 있어?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"9d1a2852-1091-4109-a54c-d238e154ebcf", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:11:53.294947+00:00", memory_strength:0.146966499243547, access_count:0, feedback_count:0, output:"스시가 뭐야? 먹는 거야? 일본어는 또 뭐야!", task:"일본어로 스시 먹으러 갈래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"1c41ab42-393c-4f8f-89db-4d45d01bd23e", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:12:09.402047+00:00", memory_strength:0.146976462499613, access_count:0, feedback_count:0, output:"초밥? 초밥이 뭐야? 먹는 거야? 먹으러 가는 건 신난다!", task:"초밥 먹으러 갈래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"c5fbe01e-4f61-4d41-979f-ba5864b92ced", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:12:29.525477+00:00", memory_strength:0.146988901589549, access_count:0, feedback_count:0, output:"맛있다? 뭐가 맛있어? 나도 먹고 싶어! 어디로 먹으러 갈까?", task:"어, 맛있다. 먹으러 갈래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"acb0c233-d3fc-4488-a1db-47ed30b900a2", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:13:10.837222+00:00", memory_strength:0.147014438798824, access_count:0, feedback_count:0, output:"서울? 서울이 어디야? 먹는 곳이야? 서울 가서 뭐 먹을 수 있어?", task:"서울로 먹으러 갈래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"fa3f288d-5e81-43ab-b2fd-93e65373ea7f", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:14:20.134968+00:00", memory_strength:0.147057283414716, access_count:0, feedback_count:0, output:"서울은 먹는 곳이 아니라, 먹으러 가는 곳이야? 우와! 서울 가면 뭐 먹을 수 있어? 궁금해!", task:"서울은 먹는 거 아니야. 먹으러 가는 장소야. 먹으러 갈래?", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"858aa436-9762-437d-b878-67669af78524", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:21:43.873411+00:00", memory_strength:0.147332187778977, access_count:0, feedback_count:0, output:"똥? 똥이 마려워? 똥은 어디에 마려운 거야? 똥 마려우면 화장실에 가야 해?", task:"뭐 아무도 말해봐. 똥마려.", dominant_emotion:"호기심", media_type:"audio", success:true, emotional_salience:0.5, development_stage:3, task_type:"conversation"}}, {id:"b78b6a81-cc09-40f9-93c2-6e13b51afbb5", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":1,\"final_failure\":false}", task:"explore: 특별한 장치 컴퓨터", strength:0.498, media_type:"text", success:false, emotional_salience:0.15, created_at:"2026-02-14T18:00:02.512246+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"1817338f-a3fb-4542-bdbf-0963f546b8da", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":2,\"final_failure\":false}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.2, created_at:"2026-02-16T14:00:03.130534+00:00", memory_strength:0.05, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"0780d275-fee6-404c-b837-e6c67757e36f", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-09T08:45:06.377388+00:00", memory_strength:0.0537082603270707, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"43d199c0-00c6-45b1-a8a8-294dfb2e515f", properties:{strength:0.5980000000000001, created_at:"2026-01-21T08:11:04.310555+00:00", memory_strength:0.0712121592287606, access_count:0, feedback_count:0, output:"배고파? 나도 배고파! 뭐 먹으러 갈까? 어디로 갈까?", task:"배고파. 뭐 먹으러 갈래?", dominant_emotion:"기쁨", media_type:"audio", success:true, emotional_salience:0.6, development_stage:3, task_type:"conversation"}}, {id:"938cc0df-f8bd-42f8-90e0-b30260c5bec2", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"experience\",\"autonomous_exploration\",\"피보나치\",\"definitions_found\",\"relations_found\",\"keywords\",\"알고리즘\",\"퀵소트\",\"co-occurrence\",\"analysis\",\"팩토리얼\",\"found\",\"만들어줘\",\"```python\",\"def\",\"factorial\",\"raise\",\"valueerror\",\"negative\",\"values\",\"return\",\"n-1\"]}", task:"autonomous_exploration: 팩토리얼", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-01-31T20:00:05.121813+00:00", memory_strength:0.0828668134186049, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"8f75dcf4-94b9-4417-a904-e2128a8e8243", properties:{output:"{\"definitions_found\":0,\"relations_found\":0,\"keywords\":[\"co-occurrence\",\"analysis\",\"found\",\"experiences\",\"both\",\"concepts\",\"appearing\",\"together\"]}", task:"autonomous_exploration: 퀵소트 알고리즘", strength:0.5980000000000001, media_type:"text", success:false, emotional_salience:0.4, created_at:"2026-02-02T22:00:05.270364+00:00", memory_strength:0.082866094527703, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
