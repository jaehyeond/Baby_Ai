UNWIND [{name:"brain_stem", properties:{phi_min:0.0, is_internal:true, color:"#4a5568", theta_max:3.14, created_at:"2026-02-07T09:35:14.8442+00:00", description:"생존 반사, 호흡, 심박 조절", radius_min:0.0, display_name:"뇌간", phi_max:6.28, theta_min:2.4, radius_max:0.3, id:"531bc6f8-d651-4657-9d6c-2da56d6ee187", display_name_en:"Brain Stem", development_stage_min:0}}, {name:"cerebellum", properties:{phi_min:4.0, is_internal:false, color:"#48bb78", theta_max:2.8, created_at:"2026-02-07T09:35:14.8442+00:00", description:"절차 기억, 운동 협응, 균형", radius_min:0.3, display_name:"소뇌", phi_max:5.5, theta_min:2.0, radius_max:0.65, id:"68867f57-9e0d-4623-ad5c-badc1b2f1272", display_name_en:"Cerebellum", development_stage_min:0}}, {name:"amygdala", properties:{phi_min:2.5, is_internal:true, color:"#f56565", theta_max:1.8, created_at:"2026-02-07T09:35:14.8442+00:00", description:"감정 처리, 공포 반응, 감정 기억", radius_min:0.15, display_name:"편도체", phi_max:3.8, theta_min:1.2, radius_max:0.4, id:"b77db588-631b-4e5a-9e64-cb528b8acf56", display_name_en:"Amygdala", development_stage_min:1}}, {name:"hippocampus", properties:{phi_min:3.8, is_internal:true, color:"#ed8936", theta_max:1.7, created_at:"2026-02-07T09:35:14.8442+00:00", description:"에피소드 기억, 공간 기억, 학습", radius_min:0.15, display_name:"해마", phi_max:5.2, theta_min:1.0, radius_max:0.45, id:"43c651cb-f7c0-4f26-9a55-a50091495305", display_name_en:"Hippocampus", development_stage_min:2}}, {name:"occipital", properties:{phi_min:5.5, is_internal:false, color:"#9f7aea", theta_max:2.8, created_at:"2026-02-07T09:35:14.8442+00:00", description:"시각 처리, 패턴 인식", radius_min:0.65, display_name:"후두엽", phi_max:7.0, theta_min:2.0, radius_max:1.0, id:"2bd5c30e-d416-4212-b7c3-8940f13dee9f", display_name_en:"Occipital Lobe", development_stage_min:1}}, {name:"temporal", properties:{phi_min:1.5, is_internal:false, color:"#4299e1", theta_max:2.0, created_at:"2026-02-07T09:35:14.8442+00:00", description:"언어 이해, 청각 처리, 정체성", radius_min:0.65, display_name:"측두엽", phi_max:3.0, theta_min:1.0, radius_max:1.0, id:"1c583a12-9e81-4977-b3da-082f3b967acb", display_name_en:"Temporal Lobe", development_stage_min:2}}, {name:"parietal", properties:{phi_min:3.5, is_internal:false, color:"#38b2ac", theta_max:1.2, created_at:"2026-02-07T09:35:14.8442+00:00", description:"공간 인지, 촉각, 수학", radius_min:0.7, display_name:"두정엽", phi_max:5.5, theta_min:0.3, radius_max:1.0, id:"a951ebf7-bb72-4328-b97d-ae0f8b69fe9b", display_name_en:"Parietal Lobe", development_stage_min:1}}, {name:"motor_cortex", properties:{phi_min:1.5, is_internal:false, color:"#ecc94b", theta_max:1.2, created_at:"2026-02-07T09:35:14.8442+00:00", description:"의도적 행동, 운동 계획", radius_min:0.75, display_name:"운동피질", phi_max:3.5, theta_min:0.5, radius_max:1.0, id:"7a783923-5415-4fed-9507-0cab544cab3c", display_name_en:"Motor Cortex", development_stage_min:2}}, {name:"prefrontal", properties:{phi_min:0.0, is_internal:false, color:"#ed64a6", theta_max:0.8, created_at:"2026-02-07T09:35:14.8442+00:00", description:"실행 기능, 추론, 계획, 자기 인식", radius_min:0.7, display_name:"전전두엽", phi_max:6.28, theta_min:0.0, radius_max:1.0, id:"4f507d38-c606-42cc-8c98-58a8a4725b4a", display_name_en:"Prefrontal", development_stage_min:3}}] AS row
