alse, emotional_salience:0.25, created_at:"2026-02-25T00:00:03.042149+00:00", memory_strength:0.0540275575033451, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"aa3267c3-ddbd-43f2-91ff-353a6356a69e", properties:{output:"{\"method\":\"internal_graph\",\"found_definitions\":1,\"found_relations\":0,\"keywords\":[\"로고\"],\"attempt\":1,\"final_failure\":false}", task:"explore: 로고", strength:0.5980000000000001, media_type:"text", success:true, emotional_salience:0.4, created_at:"2026-02-25T08:00:03.334479+00:00", memory_strength:0.104010782636442, access_count:0, task_type:"exploration", feedback_count:0}}, {id:"01dc42ef-26f6-4a41-b8ff-7fb49b2904f1", properties:{output:"{\"method\":\"memory_recall\",\"found_definitions\":0,\"found_relations\":0,\"keywords\":[],\"attempt\":3,\"final_failure\":true}", task:"explore: 깊이우선탐색", strength:0.498, media_type:"text", success:false, emotional_salience:0.25, created_at:"2026-02-25T12:00:02.677267+00:00", memory_strength:0.0540276164620214, access_count:0, task_type:"exploration", feedback_count:0}}] AS row
